  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "夕阳西沉，求主与我同居，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "黑暗渐深，求主与我同居；：",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "求助无门，安慰也无求处，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "常助孤苦之神，与我同居。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "渺小浮生，飘向生涯尽处，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "欢娱好景，转瞬都成往事；·",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "变化无常，环境何能留住？",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "恳求不变之神，与我同居。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "我深需主，时刻需主眷顾，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "除却主恩，试探何能驱除？：",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "谁能如主，时常导引扶持？",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "无论风雨晦明，恳求同居。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "有主赐福，仇敌何须畏惧？",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "泪消苦意，病痛也无足虑；",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "坟墓威权，锋芒今在何处？",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_v4",
        "text": "我仍欣然得胜，主若同居。",
        "label": "第4段：第4谱行"
      },
      {
        "region": "s1_v5",
        "text": "示我宝架，双眸垂闭之时，",
        "label": "第5段：第1谱行"
      },
      {
        "region": "s2_v5",
        "text": "照彻昏幽，指我直上天衢；",
        "label": "第5段：第2谱行"
      },
      {
        "region": "s3_v5",
        "text": "阴飞逝，欣看天光破曙，",
        "label": "第5段：第3谱行"
      },
      {
        "region": "s4_v5",
        "text": "·5.无论天上人间，恳求同居。",
        "label": "第5段：第4谱行"
      }
    ],
