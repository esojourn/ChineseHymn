    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "昨日、今日、直到永远，主话永不变，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "我主所言无论何语，句句必应验；",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "罪人得救，病人得愈，身心都安宁；",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "转悲为喜，惊慌得安，荣耀归主名！",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "虽然宇宙世界万物逐渐都改变，",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "惟有耶稣永不改变，荣耀归主名！",
        "label": "第1段：第6谱行"
      },
      {
        "region": "s7_chorus",
        "text": "荣耀归主名！荣耀归主名！惟有",
        "label": "第1段：第7谱行"
      },
      {
        "region": "s8_chorus",
        "text": "耶稣永不改变，荣耀归主名！（阿们）",
        "label": "第1段：第8谱行"
      },
      {
        "region": "s1_v2",
        "text": "我主乃是罪人朋友，特来施拯救，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "大家就近恩主脚前，忏悔谦卑求；",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "救主慈言：罪莫再犯，你罪皆赦免。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "自昔至今，永永远远，主恩不改变。",
        "label": "第2段：第4谱行"
      },
      {
