  "independentTimelines": {
    "05-347爱传福音歌.mp3": {
      "definitions": [
        {
          "region": "s1_v1",
          "text": "我爱传扬主福音，讲说天上事情，",
          "label": "第1段：第1谱行"
        },
        {
          "region": "s2_v1",
          "text": "讲说耶稣的妙爱，讲说耶稣光荣。",
          "label": "第1段：第2谱行"
        },
        {
          "region": "s3_v1",
          "text": "我爱传扬主福音，因知福音真实，",
          "label": "第1段：第3谱行"
        },
        {
          "region": "s4_v1",
          "text": "福音满足我希望，福音加添我力。",
          "label": "第1段：第4谱行"
        },
        {
          "region": "s5_chorus",
          "text": "我爱传扬主福音，讲说耶稣的妙爱，",
          "label": "第1段：第5谱行"
        },
        {
          "region": "s6_chorus",
          "text": "讲说耶稣的事情，真是非常甘美。（阿们）",
          "label": "第1段：第6谱行"
        },
        {
          "region": "s1_v2",
          "text": "我爱传扬主福音，看为无上奇珍，",
          "label": "第2段：第1谱行"
        },
        {
          "region": "s2_v2",
          "text": "胜过一切黄金梦，一 切新奇 事情。",
          "label": "第2段：第2谱行"
        },
        {
          "region": "s3_v2",
          "text": "我爱传扬主福音，福音有益我灵，",
          "label": "第2段：第3谱行"
        },
        {
          "region": "s4_v2",
          "text": "如今我来传给你，便是为这原因。",
          "label": "第2段：第4谱行"
        },
        {
          "region": "s5_chorus",
          "text": "我爱传扬主福音，讲说耶稣的妙爱，",
          "label": "第2段：第5谱行"
        },
        {
          "region": "s6_chorus",
          "text": "讲说耶稣的事情，真是非常甘美。（阿们）",
          "label": "第2段：第6谱行"
        },
        {
          "region": "s1_v3",
          "text": "我爱传扬主福音，真有十分兴味，",
          "label": "第3段：第1谱行"
        },
        {
          "region": "s2_v3",
          "text": "每次从头说一回，便觉更加甜蜜。",
          "label": "第3段：第2谱行"
        },
        {
          "region": "s3_v3",
          "text": "我爱传扬主福音，因有多少的人，",
          "label": "第3段：第3谱行"
        },
        {
          "region": "s4_v3",
          "text": "未闻上帝的真道，慈悲救世佳音。",
          "label": "第3段：第4谱行"
        },
        {
          "region": "s5_chorus",
          "text": "我爱传扬主福音，讲说耶稣的妙爱，",
          "label": "第3段：第5谱行"
        },
        {
          "region": "s6_chorus",
          "text": "讲说耶稣的事情，真是非常甘美。（阿们）",
          "label": "第3段：第6谱行"
        },
        {
          "region": "s1_v4",
          "text": "我爱传扬主福音，深知福音的人，",
          "label": "第4段：第1谱行"
        },
        {
          "region": "s2_v4",
          "text": "仍旧如饥如渴地喜欢与人同听。",
          "label": "第4段：第2谱行"
        },
        {
          "region": "s3_v4",
          "text": "将来眼见主光荣，我必歌唱新声，",
          "label": "第4段：第3谱行"
        },
        {
          "region": "s4_v4",
          "text": "新声依旧是当初我心所爱福音。",
          "label": "第4段：第4谱行"
        },
        {
          "region": "s5_chorus",
          "text": "我爱传扬主福音，讲说耶稣的妙爱，",
          "label": "第4段：第5谱行"
        },
        {
          "region": "s6_chorus",
          "text": "讲说耶稣的事情，真是非常甘美。（阿们）",
          "label": "第4段：第6谱行"
        }
      ],
