    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "我与救主同行，行于光明福音，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "，1.何等荣耀照亮我路程；当我听主命令，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "主便与我同行，信靠顺服者，主必同行。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "信靠顺服，此外别法全无，若要得耶稣喜乐，",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "惟有信靠顺服。（阿们）",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s1_v2",
        "text": "没有黑影幽暗，也无云雾迷漫，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "我主笑容使云雾消散；没有疑感畏惧，",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "也无叹息忧虑，信靠顺服者，主必同行。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "信靠顺服，此外别法全无，若要得耶稣喜乐，",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "惟有信靠顺服。（阿们）",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s1_v3",
        "text": "不要背负重担，不要愁闷哀叹，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "一切劳苦者主赐平安；再无忧伤哭泣，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "再无怨恨怒气，信靠顺服者，主必同行。",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "信靠顺服，此外别法全无，若要得耶稣喜乐，",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "惟有信靠顺服。（阿们）",
        "label": "第3段：第5谱行"
      },
      {
        "region": "s1_v4",
        "text": "主与我作朋友，我可常向主求，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "救主携我手一路同走；主吩咐我就听，",
        "label": "第4段：第2谱行"
      },
      {
