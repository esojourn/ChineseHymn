  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "神圣纯爱，超乎万爱，天上欢乐降人间！",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "恳求屈尊居我心中，超过寻常恩万般；",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "耶稣，主是万爱结晶，怜悯慈悲集大成；",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "求携救恩惠然来临，进入颗颗战栗心。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "悬求主将爱的精神，吹入每颗烦恼心；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "主所应许甜蜜安息，但愿人人得继承；",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "恳求去掉爱罪心怀，成全我灵始与终；",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "信的结果，美如开端，自由释放我心衷。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "全能神啊，求来救拯，容我接受主生命；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "我心主殿，愿主忽临，永不，永不离我心；",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "但愿时常颂主事主，犹如天上众天军，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "祈祷赞扬，永无停止，完全爱里永欢欣。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "求主完成再造深恩，使我洁清无瑕疵；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "使我能见宏大救恩，再得归回主爱里；",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "愿从光荣再进光荣，身列天班长供奉，",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_v4",
        "text": "到时免冠，主前抛掷，忘形爱颂惊奇中。",
        "label": "第4段：第4谱行"
      }
    ],
