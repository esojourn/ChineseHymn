    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "你的生命藉我表彰，耶稣我主万王之",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "王；使我能有你的形状，随时随在",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "为你发光。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s1_v2",
        "text": "你的大爱藉我宣扬，耶稣我主万王之",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "王；使我作你反光明镜，将你荣美",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "昭显与人。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s1_v3",
        "text": "你的工作我愿担当，耶稣我主万王之",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "王；全心全力由你支配，凭你差遣",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "决不推。",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s1_v4",
        "text": "忧喜甘苦与你共尝，耶稣我主万王之",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "王；成为你的忠心伴侣，一生一世",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "跟主到底。（阿们)",
        "label": "第4段：第3谱行"
      }
