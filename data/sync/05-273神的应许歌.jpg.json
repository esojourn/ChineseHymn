    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "神未曾应许：天色常蓝，人生的路途花香常漫；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "神未曾应许：常晴无雨，常乐无痛苦，常安无虞。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "神却曾应许：生活有力，行路有光亮，作工得息，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "试炼得恩助，危难有赖，无限的体谅，不尽的爱。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "神未曾应许：不遇试探、懊恼和忧虑、不幸悲叹；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "神未曾应许：不负重担、繁忙的事务、周折、困难。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "神却曾应许：生活有力，行路有光亮，作工得息，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "试炼得恩助，危难有赖，无限的体谅，不尽的爱。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "神未曾应许：路常平坦，任意地奔跑，毫无阻拦，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "没有深水阻，汪洋一片，没有大山挡，高薄云天。",
