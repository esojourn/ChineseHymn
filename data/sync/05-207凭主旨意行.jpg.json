  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "凭主旨意“行，凭主意行，因主是窑匠，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "我是泥土；陶我与造我，照主旨意，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "我在此等待，敬候我主。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s1_v2",
        "text": "凭主旨意行，凭主意行，鉴察试验我，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "就在今天；求主洗涤我，洁白如雪，",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "我谦卑跪下，在主足前。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s1_v3",
        "text": "凭主旨意行，凭主意行，悲伤与疲倦，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "求主扶助；权柄众权柄，全是主的，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "抚摸并医治，惟靠救主。",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s1_v4",
        "text": "凭主旨意行，凭主意行，管理我动作，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "全听指挥；圣灵充满我，显然可见，",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "惟独有耶稣，居我心内。（阿们）",
        "label": "第4段：第3谱行"
      }
    ],
