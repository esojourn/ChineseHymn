  "performanceOrder": [
    {
      "region": "r1",
      "text": "有一美意入我心灵； 使我喜乐发出歌声； 反复欢呼不住歌颂； 平安由神恩赐来。",
      "label": "第1段"
    },
    {
      "region": "r2",
      "text": "平安，平安，奇妙平安由神来， 奇妙平安由神而来， 奇妙平安由神来。",
      "label": "第1段"
    },
    {
      "region": "r3",
      "text": "有十字架才有安宁， 主代我死罪债还清； 无其他根基能稳定； 因这平安由神来。",
      "label": "第2段"
    },
    {
      "region": "r4",
      "text": "平安，平安，奇妙平安由神来， 奇妙平安由神而来， 奇妙平安由神来。",
      "label": "第2段"
    },
    {
      "region": "r5",
      "text": "当我承认耶稣救主； 我心充满安慰丰富； 从主我受无限恩福； 平安由神恩赐来。",
      "label": "第3段"
    },
    {
      "region": "r6",
      "text": "平安，平安，奇妙平安由神来， 奇妙平安由神而来， 奇妙平安由神来。",
      "label": "第3段"
    },
    {
      "region": "r7",
      "text": "居主恩中得享安详； 时常靠近救主身旁； 惟他能赐平安指望； 平安由神恩赐来。",
      "label": "第4段"
    },
    {
      "region": "r8",
      "text": "平安，平安，奇妙平安由神来， 奇妙平安由神而来， 奇妙平安由神来。",
      "label": "第4段"
    }
