  "independentTimelines": {
    "05-075普世欢腾歌.mp3": {
      "definitions": [
        {
          "region": "s1_v1",
          "text": "普世欢腾！救主下降，大地接她君王；",
          "label": "第1段：第1谱行"
        },
        {
          "region": "s2_v1",
          "text": "惟愿众心预备地方，诸天万物歌唱，",
          "label": "第1段：第2谱行"
        },
        {
          "region": "s3_v1",
          "text": "诸天万物歌唱，诸天，诸天万物歌唱。",
          "label": "第1段：第3谱行"
        },
        {
          "region": "s1_v2",
          "text": "普世欢腾！主治万方，民众首当歌唱；",
          "label": "第2段：第1谱行"
        },
        {
          "region": "s2_v2",
          "text": "沃野、洪涛、山石、平原，响应歌声亮，",
          "label": "第2段：第2谱行"
        },
        {
          "region": "s3_v2",
          "text": "响 应歌声嘹 亮,响 应，响应 歌声嘹亮。",
          "label": "第2段：第3谱行"
        },
        {
          "region": "s1_v3",
          "text": "罪恶忧愁不容再长，世途荆棘消亡；",
          "label": "第3段：第1谱行"
        },
        {
          "region": "s2_v3",
          "text": "化诅为恩，无远弗届，到处主泽流长，",
          "label": "第3段：第2谱行"
        },
        {
          "region": "s3_v3",
          "text": "到处主泽流长，到处，到处主泽流长。",
          "label": "第3段：第3谱行"
        },
        {
          "region": "s1_v4",
          "text": "主藉真理恩治万方，要使万邦证明：",
          "label": "第4段：第1谱行"
        },
        {
          "region": "s2_v4",
          "text": "上主公义无限荣光，主爱奇妙莫名，",
          "label": "第4段：第2谱行"
        },
        {
          "region": "s3_v4",
          "text": "主爱奇妙莫名，主爱，主爱奇妙莫名。",
          "label": "第4段：第3谱行"
        }
      ],
