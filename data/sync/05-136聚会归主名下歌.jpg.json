    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "恩主我们在此，聚会归你名下，切愿你赐恩慈，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "将我们接纳。照你所赐应许，你与我们同在，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "灵里彼此相遇，交通无阻碍。照你所赐应·许，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "你与我们同在，灵里彼此相遇，交通无阻碍。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "我们同来敬拜，以灵以诚为祭，不分此宗彼派，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "主里合为一。教导我们祷告，符合我主心愿，",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "求主此刻开导，你旨得成全。教导我们祷告，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "符合我主心愿，求主此刻开导，你旨得成全。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "今天所传信息，求主加上祝福，吗哪灵粮充饥，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "信众得饱足。今天倘有迷羊，至今徘徊等待，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "但愿你话放光，照亮他回来。今天倘有迷羊，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "至今徘徊等待，但愿你话放光，照亮他回来。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "创始成终基督，惟你作主带领，生命亮光鼓舞，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "全由你供应。教我谨守真道，生活益人荣神，",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "垂听我们祷告，奉主名，阿们。教我谨守真道，",
        "label": "第4段：第3谱行"
      },
      {
