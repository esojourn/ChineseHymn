    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "同来加冕生命之王，荣耀都归给他！",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "使我莫忘主荆棘冕，领我到各各他。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "使我莫忘客西马尼，主受痛苦何等之大！",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "使我莫忘主爱为我，领我到各各他。（阿们）",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "求主示我埋你坟墓，你为我尝死味；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "愿象天使身穿白衣，在主坟墓守卫。．",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "使我莫忘客西马尼，主受痛苦何等之大！",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "使我莫忘主爱为我，领我到各各他。（阿们）",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "我愿献礼来到墓旁，象当年马利亚；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "主已复活，主墓已空，领我到各各他。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "使我莫忘客西马尼，主受痛苦何等之大！",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "使我莫忘主爱为我，领我到各各他。（阿们）",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "我真甘心，我真情愿，背十字架跟主；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "我愿与主同尝苦杯，因主为我受苦。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "使我莫忘客西马尼，主受痛苦何等之大！",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "使我莫忘主爱为我，领我到各各他。（阿们）",
        "label": "第4段：第4谱行"
      }
    ],
