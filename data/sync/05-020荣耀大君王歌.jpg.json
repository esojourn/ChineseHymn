  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "齐当俯伏拜，荣耀大君王！主权力仁慈，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "须同心颂扬！主亘古如盾牌，护我免灾害，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "荣光罩若宫帷，颂声环如带。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s1_v2",
        "text": "大地浮空间，满藏珍与宝，全归主能力，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "不绝施创造；主命-全爱，全权-万物即建立，",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "主使碧海苍波周围绕大地。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s1_v3",
        "text": "人舌何能述我主关切心.主使风吹拂，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "主使光生明；主使高山泉源下注遍平壤，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "主使甘霖时雨润泽各地方。",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s1_v4",
        "text": "权能无限量！慈爱深莫测！天使在天上。",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "歌颂声不息；地上众生赞美，随从众天军，",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "尽力！尽心！尽意！赞美主荣名。（阿们）",
        "label": "第4段：第3谱行"
      }
    ],
