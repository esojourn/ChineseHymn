    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "任遭何事不要惊怕，天父必看顾你；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "必将你藏他恩翅下，天父必看顾你。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "天父必看顾你，时时看顾，处处看顾，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "他必要看顾你，天父必看顾你。（阿们）",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "有时劳苦心中失望，天父必看顾你；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "危险临到无处躲藏，天父必看顾你。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "天父必看顾你，时时看顾，处处看顾，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "他必要看顾你，天父必看顾你。（阿们）",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "凡你所需他必预备，天父必看顾你；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "凡你所求他不推，天父必看顾你。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "天父必看顾你，时时看顾，处处看顾，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "他必要看顾你，天父必看顾你。（阿们）",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "无论经过何等试炼，天父必看顾你；",
        "label": "第4段：第1谱行"
      },
      {
