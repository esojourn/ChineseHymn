  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "一百只羊，有九十九，在主栏中安眠；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "但有一只远离金门，迷路群山之间；",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "远在荒山空谷徘徊，远离良牧照顾慈怀，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "远离良牧照顾慈怀。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "“此间主有九十九只，难道还嫌不够？”",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "良牧回答：“那只迷羊，本来是我所有；",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "路径虽然高低不平，旷野虽远，我必去寻，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "旷野虽远，我必去寻。”",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "得救之羊，从未知道，路中山高水深；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "不知长夜何等黑暗，寻羊何等艰辛。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "旷野之中，救主遥闻迷羊失望垂死哀鸣，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "迷羊失望垂死哀鸣。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "问主：“山径沿途血迹，到底从何面来？”",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "主说：“牧人必须流血，迷羊才救得回。”",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "问主：“双手因何伤裂？”主说：“因为路多荆棘，”",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_v4",
        "text": "主说：“因为路多荆棘。”",
        "label": "第4段：第4谱行"
      },
      {
        "region": "s1_v5",
        "text": "远从迅雷轰破之山，穿过危崖绝壁，",
        "label": "第5段：第1谱行"
      },
      {
        "region": "s2_v5",
        "text": "牧人呼声直达天门：“乐哉，亡羊已得。”",
        "label": "第5段：第2谱行"
      },
      {
        "region": "s3_v5",
        "text": "围绕宝座天使和唱：“乐哉，主已觅得亡羊！",
        "label": "第5段：第3谱行"
      },
      {
        "region": "s4_v5",
        "text": "乐哉，主已觅得亡羊!”（阿们）",
        "label": "第5段：第4谱行"
      }
    ],
