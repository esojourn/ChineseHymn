  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "耶稣，我已负起十架，撇下一切随主行；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "愿受饥寒、困贫、离弃，爱主贯彻我终身。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "舍了从前诸般奢望，凡所寻求凡所欲；",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "主与天堂，仍为我有，我的境遇何富足！",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "万一有人给我忧愁，便是驱我到主前；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "万一境遇使我艰难，天堂安乐更加添。．",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "有了主的慈悲恩爱，艰难痛苦都无妨；",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "喜乐若非主所赐给，不能使我心欢畅。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "我灵应当接受救恩，脱离罪恶免忧惊；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "无论处于何等境遇，欣然从主向前行。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "当思圣灵将你感化，天父向你显慈容，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "救主牺牲，将你救赎，何可抱怨在心中？",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "当从恩典奔向光荣，祈祷为翼，信为盾；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "永生光明照你面前，上主亲手引你行。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "转眼完了世间本分，过了旅客短时光，",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_v4",
        "text": "望变欢欣，祷变颂扬，信变见主，爱永长。",
        "label": "第4段：第4谱行"
      }
    ],
