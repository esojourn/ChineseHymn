    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "基督完成赎罪奇功，何等奇妙的救主！",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "我罪清偿，他恩无穷，何等奇妙的救主！",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "何等奇妙的救主！是耶稣，主耶稣！",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "何等奇妙的救主！是耶稣我主！（阿们）．",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
