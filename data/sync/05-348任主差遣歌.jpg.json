  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "主愿用我事他之处，未必是隔重洋，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "未必是在 荒山僻路，艰难 危险战场。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "但闻救主微声招呼，特意提我微名，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "我拉主手，欣 然应答：命我何往必听。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "差我何往，我必前往；命我何言，必言；",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "派我何事，我乐担当，身心甘献主前。",
        "label": "第1段：第6谱行"
      },
      {
        "region": "s1_v2",
        "text": "如今有主恩爱之语，耶稣愿我传告，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "如若有人行走错路，耶稣愿我寻找。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "主肯前引，前途光明，虽行幽暗之中，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "既闻主命，愿 随主步，叫我何言必从。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "差我何往，我必前往；命我何言，必言；",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "派我何事，我乐担当，身心甘献主前。",
        "label": "第2段：第6谱行"
      },
      {
        "region": "s1_v3",
        "text": "我知有我作工之处，在世广大禾田，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "一生时日 不再虚度，全为 荣主在天。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "今将所有全交我主，报主莫大恩情，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "遵主美旨，我乐顺服，派我何事必行。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "差我何往，我必前往；命我何言，必言；",
        "label": "第3段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "派我何事，我乐担当，身心甘献主前。",
        "label": "第3段：第6谱行"
      }
