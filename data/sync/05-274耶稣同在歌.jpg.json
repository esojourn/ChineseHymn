    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "主释放我洗尽罪污，在地如天终日欢呼；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "世上难免忧愁困苦，认识耶稣天堂正路。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "哈利路亚！真是天堂！罪蒙救免真是天堂；无论岸",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "上，无论海洋，耶稣同在就是天堂。（阿们）",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "从前天堂和我隔开，感谢耶稣显出慈爱；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "如今天堂在我心怀，永永远远不会更改。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "哈利路亚！真是天堂！罪蒙救免真是天堂；无论岸",
