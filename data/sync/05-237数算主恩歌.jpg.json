    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "有时遇见苦难如同大波浪，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "有时忧愁丧胆似乎要绝望，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "若把主的恩典从头数——数，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "必能叫你 惊讶立时 乐 欢 呼。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "主的恩典样样都要数，主的恩典都要记清楚，",
