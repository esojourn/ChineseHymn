    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "赞美我天父，因他差遣爱子，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "降生来到这世界，为罪人受死。",
        "label": "第1段：第2谱行"
      },
      {
