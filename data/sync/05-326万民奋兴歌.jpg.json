    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "清晨之光渐放射，黑暗渐行消灭，’",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "大地人民正醒来，痛悔从前罪孽；",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "吹过海面的和风，带到远方消息，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "报道万民都奋兴，预备邹城克敌。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "待看万民同敬拜我众所爱之神，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "万心如香渐上升，大家感激主恩；",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "待看罪人都认罪，大家顺从福音，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "寻求救主的福佑，服事惟一至尊。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "但愿救恩如川流，滔滔滚滚前行，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "流遍五洲的万国，丰满与日俱增；",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "直到卑贱的人民，得胜回归家庭；",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "直到圣洁的人民，都说“上主已临”！",
        "label": "第3段：第4谱行"
      }
    ],
