    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "听救主永生的诫命，他的命令不变更，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "守诫信道是我本分，主说遵命有福分。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "遵诚命的人是有福，诚哉，他们是有福，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "遵诫命的人是有福，有福，有福属他们。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "主命令若听而不行，虽应许无益我身，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "听而惧怕仍无功效，主赐福遵行的人。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "遵诚命的人是有福，诚哉，他们是有福，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "遵诫命的人是有福，有福，有福属他们。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "遵行的人能进圣城，无罪孽、忧愁、纷争，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "那里永远圣洁荣耀，生命果子必有分。，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "遵诚命的人是有福，诚哉，他们是有福，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "遵诫命的人是有福，有福，有福属他们。",
        "label": "第3段：第4谱行"
