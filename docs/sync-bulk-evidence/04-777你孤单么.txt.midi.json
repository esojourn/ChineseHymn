  "performanceOrder": [
    {
      "region": "r1",
      "text": "你孤单么？真孤单么？ 耶稣比你更孤单！ 他曾降生成为人子， 受尽凌辱苦难堪！",
      "label": "第1段"
    },
    {
      "region": "r2",
      "text": "他曾孤单在城里面， 曾孤单在加略山。 未见一人与他同行， 试想他心何凄惨！",
      "label": "第1段"
    },
    {
      "region": "r3",
      "text": "你困倦么？真困倦么？ 耶稣比你更困倦！ 当他即将走完世路， 犹背苦架挨熬煎！",
      "label": "第2段"
    },
    {
      "region": "r4",
      "text": "他曾困倦在那晚间， 他曾困倦不能眠； 大声祈祷汗如血点， 跪在客西马尼园。",
      "label": "第2段"
    },
    {
      "region": "r5",
      "text": "你贫穷么？真贫穷么？ 耶稣比你更贫穷！ 飞鸟有巢，狐狸有洞， 惟有他常奔西东。",
      "label": "第3段"
    },
    {
      "region": "r6",
      "text": "从未安身走遍乡城， 宣传天道人不听； 想他生在客店马棚， 葬在他人坟墓中。",
      "label": "第3段"
    },
    {
      "region": "r7",
      "text": "你担重么？真担重么？ 耶稣比你担更重！ 他能担当你我忧伤， 安慰你我苦心衷！",
      "label": "第4段"
    },
    {
      "region": "r8",
      "text": "他曾亲身背负重担， 带荆棘冕历忧痛； 十字架上他曾被悬， 为救你我进天宫。",
      "label": "第4段"
    }
  ],
