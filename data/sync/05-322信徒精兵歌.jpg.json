    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "信徒如同精兵，奋勇向前行，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "十字架为旗号，先路导我程！",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "基督乃是君王，领我向前方；",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "故当仰望魔旗，前行入战场。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "信徒如同精兵，奋勇向前行，十字架为",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "旗号，先路导我程！（阿们）",
        "label": "第1段：第6谱行"
      },
      {
        "region": "s1_v2",
        "text": "赖此旗号必胜，攻退撒但军；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "我为基督精兵，追敌要勤奋！",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "地狱根基震动，因闻大声颂；",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "弟兄皆当欢呼，赞美声须洪。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "信徒如同精兵，奋勇向前行，十字架为",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "旗号，先路导我程！（阿们）",
        "label": "第2段：第6谱行"
      },
      {
        "region": "s1_v3",
        "text": "教会在此寰宇，行动犹军旅，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "弟兄奋力前趋，紧跟先圣步；",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "我众原非分裂，我众是一体，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "希望信仰无二，爱心亦惟—。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "信徒如同精兵，奋勇向前行，十字架为",
        "label": "第3段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "旗号，先路导我程！（阿们）",
        "label": "第3段：第6谱行"
      },
      {
        "region": "s1_v4",
        "text": "惟愿主民心坚，联步齐向前！",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "大家均须同声，高歌庆凯旋！",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "但愿荣光赞美，均归主圣名；",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_v4",
        "text": "天使世人→致，歌声永不停。",
        "label": "第4段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "信徒如同精兵，奋勇向前行，十字架为",
        "label": "第4段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "旗号，先路导我程！（阿们）",
