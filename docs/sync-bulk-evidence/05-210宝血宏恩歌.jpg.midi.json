      "definitions": [
        {
          "region": "s1_v1",
          "text": "我听主声欢迎，召我与主相亲，",
          "label": "第1段：第1谱行"
        },
        {
          "region": "s2_v1",
          "text": "在主所流宝血里面，我心能够洗净。",
          "label": "第1段：第2谱行"
        },
        {
          "region": "s3_chorus",
          "text": "主啊，我今来，我今来就主！求用宝血",
