    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "耶稣爱我万不错，因有圣书告诉我；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "凡属我主众小羊，虽然软弱主强壮。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "主耶稣爱我，主耶稣爱我，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "主耶稣爱我，圣书上告诉我。’（阿们）",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "耶稣爱我舍性命，将我罪恶洗干净；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "天堂荣门替我开，把他小羊引进来。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "主耶稣爱我，主耶稣爱我，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "主耶稣爱我，圣书上告诉我。’（阿们）",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "耶稣爱我永不忘，永不离开他小羊；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "白日遭难主搭救，黑夜睡觉主看守。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "主耶稣爱我，主耶稣爱我，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "主耶稣爱我，圣书上告诉我。’（阿们）",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "耶稣爱我爱到底，爱我罪人真希奇；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "倘若生前我爱他，死后领我到他家。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "主耶稣爱我，主耶稣爱我，",
