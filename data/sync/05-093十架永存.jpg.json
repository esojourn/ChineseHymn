  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "在各各他山上，孤立十字宝架，至羞辱至苦痛记号；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "在此真神爱子为众罪人钉死，这十架为我最爱至宝。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "故我高声称颂主十架，直到在主台前见父 面，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我一生要背负主十架，十字架可换公义冠冕。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "各各他之十架，虽然有人藐视，于我却是真神仁慈；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "神子耶稣基督甘离天堂荣华，在此十字架被人钉死。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "故我高声称颂主十架，直到在主台前见父 面，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我一生要背负主十架，十字架可换公义冠冕。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "各各他之十架，虽然满有血迹，我仍然以此架为圣；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "因在此宝架上，我救主舍生命，洗我众罪并使我成圣。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "故我高声称颂主十架，直到在主台前见父 面，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我一生要背负主十架，十字架可换公义冠冕。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "我愿忠心随主，不以福音为耻，甘愿背负十字宝架；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "不日救主再临，迎接我众升天，永远享福乐荣归天家。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "故我高声称颂主十架，直到在主台前见父 面，",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我一生要背负主十架，十字架可换公义冠冕。",
        "label": "第4段：第4谱行"
      }
    ],
