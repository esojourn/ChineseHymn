    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "主大慈爱寻找我，我正疲倦可怜；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "他显大力怀抱我，安放羊群里边。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "此恩激动天使欢唱，甚至歌声满天回 响。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "爱何大！寻找我；血何宝！洗净我；恩何宽！",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "领我归回羊群；恩何宽!领我归回羊群。（阿）",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s1_v2",
        "text": "主看见我有创伤，用油和酒包裹；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "又以恩言安慰说：“从此你永属我。”",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "我未听过如此佳音，能叫我心满足欢欣。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "爱何大！寻找我；血何宝！洗净我；恩何宽！",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "领我归回羊群；恩何宽!领我归回羊群。（阿）",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s1_v3",
        "text": "主指我看钉痕手，宝血为我流出；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "人用荆棘作冠冕，戏弄而且凌辱。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "我真希奇，为我罪人，主竟受苦如此之深！",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "爱何大！寻找我；血何宝！洗净我；恩何宽！",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "领我归回羊群；恩何宽!领我归回羊群。（阿）",
        "label": "第3段：第5谱行"
      },
      {
        "region": "s1_v4",
        "text": "我今安坐他面前，蒙他光照赐恩；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "满心敬爱我救主，希奇他恩何深！",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "我虽能赞他到永远，不足说尽他恩无限。",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "爱何大！寻找我；血何宝！洗净我；恩何宽！",
        "label": "第4段：第4谱行"
      },
      {
        "region": "s5_chorus",
