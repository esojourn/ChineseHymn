    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "我一路蒙救主引导，舍此外我复何求？",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "毕生时刻作我前导，奇妙爱古今未有；",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "天上平安，属灵福乐，凭信心享受无涯，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "因我知无论遭何事，主所作尽美尽佳。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_v1",
        "text": "因我知无论遭何事，主所作尽美尽佳。",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s1_v2",
        "text": "我一路蒙救主引导，艰难时赐我安康，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "试炼中有丰盛恩惠，赐灵食充我饥肠；",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "虽我行路有时倾跌，我心灵干渴难名，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "在我前磐石涌活泉，喜乐如水常丰盈。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_v2",
        "text": "在我前磐石涌活泉，喜乐如水常丰盈。",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s1_v3",
        "text": "我一路蒙救主引导，主大爱何等完全！",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "曾应许赐我永安息，在天家何等美满！",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "时日且至，我将变化，见主面与主相亲，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "到永远我唱此美歌，主曾一路引我行。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s5_v3",
        "text": "到永远我唱此美歌，主曾一路引我行。",
        "label": "第3段：第5谱行"
      }
