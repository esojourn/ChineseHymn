  "independentTimelines": {
    "05-319荣美福地歌.mp3": {
      "definitions": [
        {
          "region": "s1_v1",
          "text": "前在埃及为罪奴仆，备尝罪中苦味，",
          "label": "第1段：第1谱行"
        },
        {
          "region": "s2_v1",
          "text": "铁炉火热，重轭难当，魔力殊可畏。",
          "label": "第1段：第2谱行"
        },
        {
          "region": "s3_v1",
          "text": "时常叹息，欲脱不能，黑暗权势蒙蔽，",
          "label": "第1段：第3谱行"
        },
        {
          "region": "s4_v1",
          "text": "可怜从未曾知荣美福地。",
          "label": "第1段：第4谱行"
        },
        {
          "region": "s5_chorus",
          "text": "今我居巍巍高山，在光天化日之下；",
          "label": "第1段：第5谱行"
        },
        {
          "region": "s6_chorus",
          "text": "我饮于滚滚活泉，此泉长流不息。乐哉！",
          "label": "第1段：第6谱行"
        },
        {
          "region": "s7_chorus",
          "text": "有吗哪为我筵席，取之不尽用不竭。乐哉！",
          "label": "第1段：第7谱行"
        },
        {
          "region": "s8_chorus",
          "text": "今我居荣美福地。（阿们）",
          "label": "第1段：第8谱行"
        },
        {
          "region": "s1_v2",
          "text": "赖羔羊血得出埃及，面前红海分开，",
          "label": "第2段：第1谱行"
        },
        {
          "region": "s2_v2",
          "text": "茫茫旷野，迷我眼目，帮助从何来？，",
          "label": "第2段：第2谱行"
        },
        {
          "region": "s3_v2",
          "text": "信心软弱，时发怨言，仇敌内外攻击，",
          "label": "第2段：第3谱行"
        },
        {
          "region": "s4_v2",
          "text": "飘流无定，未进荣美福地。",
          "label": "第2段：第4谱行"
        },
        {
          "region": "s5_chorus",
          "text": "今我居巍巍高山，在光天化日之下；",
          "label": "第2段：第5谱行"
        },
        {
          "region": "s6_chorus",
          "text": "我饮于滚滚活泉，此泉长流不息。乐哉！",
          "label": "第2段：第6谱行"
        },
        {
          "region": "s7_chorus",
          "text": "有吗哪为我筵席，取之不尽用不竭。乐哉！",
          "label": "第2段：第7谱行"
        },
        {
          "region": "s8_chorus",
          "text": "今我居荣美福地。（阿们）",
          "label": "第2段：第8谱行"
        },
        {
          "region": "s1_v3",
          "text": "约但河边迦南美地，我心羡慕已久，",
          "label": "第3段：第1谱行"
        },
        {
          "region": "s2_v3",
          "text": "因信渡河，勇遵主命，河水竟倒流！",
          "label": "第3段：第2谱行"
        },
        {
          "region": "s3_v3",
          "text": "欣登彼岸美妙乐土，时常流奶与蜜。",
          "label": "第3段：第3谱行"
        },
        {
          "region": "s4_v3",
          "text": "哈利路亚！乐居荣美福地！",
          "label": "第3段：第4谱行"
        },
        {
          "region": "s5_chorus",
          "text": "今我居巍巍高山，在光天化日之下；",
          "label": "第3段：第5谱行"
        },
        {
          "region": "s6_chorus",
          "text": "我饮于滚滚活泉，此泉长流不息。乐哉！",
          "label": "第3段：第6谱行"
        },
        {
          "region": "s7_chorus",
          "text": "有吗哪为我筵席，取之不尽用不竭。乐哉！",
          "label": "第3段：第7谱行"
        },
        {
          "region": "s8_chorus",
          "text": "今我居荣美福地。（阿们）",
          "label": "第3段：第8谱行"
        },
        {
          "region": "s1_v4",
          "text": "任他风涛奔腾澎湃，于我究有何害？",
          "label": "第4段：第1谱行"
        },
        {
          "region": "s2_v4",
          "text": "一切事上，得胜有余，仰赖主恩爱。",
          "label": "第4段：第2谱行"
        },
        {
          "region": "s3_v4",
          "text": "耶利哥城不战自陷，主话大有能力，",
          "label": "第4段：第3谱行"
        },
        {
          "region": "s4_v4",
          "text": "高唱凯歌，声遍荣美福地。",
          "label": "第4段：第4谱行"
        },
        {
          "region": "s5_chorus",
          "text": "今我居巍巍高山，在光天化日之下；",
          "label": "第4段：第5谱行"
        },
        {
          "region": "s6_chorus",
          "text": "我饮于滚滚活泉，此泉长流不息。乐哉！",
          "label": "第4段：第6谱行"
        },
        {
          "region": "s7_chorus",
          "text": "有吗哪为我筵席，取之不尽用不竭。乐哉！",
          "label": "第4段：第7谱行"
        },
        {
          "region": "s8_chorus",
          "text": "今我居荣美福地。（阿们）",
          "label": "第4段：第8谱行"
        },
        {
          "region": "s1_v5",
          "text": "此地福乐红日高升，路径滴下脂油，",
          "label": "第5段：第1谱行"
        },
        {
          "region": "s2_v5",
          "text": "春光华丽，景物鲜明，百果庆丰收。",
          "label": "第5段：第2谱行"
        },
        {
          "region": "s3_v5",
          "text": "意外平安，无穷欢喜，永享更美安息，",
          "label": "第5段：第3谱行"
        },
        {
          "region": "s4_v5",
          "text": "赞颂主恩，赐我荣美福地。",
          "label": "第5段：第4谱行"
        },
        {
          "region": "s5_chorus",
          "text": "今我居巍巍高山，在光天化日之下；",
          "label": "第5段：第5谱行"
        },
        {
