    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "前有一日我意立定，信靠耶稣救赎我灵，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "那时心中实在高兴，愿到四方传扬主名。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "快乐日，快乐日，救主洗净我众罪孽。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "心里清洁，极大欢喜，这日永远不能忘记。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "快乐日，快乐日，救主洗净我众罪孽。",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s1_v2",
        "text": "耶稣舍命激励我爱，故此奉献全身全心，",
        "label": "第2段：第1谱行"
