  "performanceOrder": [
    {
      "region": "r1",
      "text": "愿我信心永不退后，仇敌压迫不慌， 纵有苦难灾祸当前，心中亦不惊惶。",
      "label": "第1段"
    },
    {
      "region": "r2",
      "text": "倘因管教遭受责打，心中毫无怨言， 倘遇痛苦或是忧伤，紧靠父神胸前。",
      "label": "第2段"
    },
    {
      "region": "r3",
      "text": "每遇狂风暴雨来侵，愿我信心加增， 黑暗之中疑惑不生，临危全无恐惊。",
      "label": "第3段"
    },
    {
      "region": "r4",
      "text": "世人厌弃心不动摇，讥笑也不在意， 烦恼苦海不能淹没，不中撒旦诡计。",
      "label": "第4段"
    },
    {
      "region": "r5",
      "text": "求主赐我无比信心，任遭何事不畏， 虽在今世亦能尝到，永生天恩滋味。",
      "label": "第5段"
    }
  ],
