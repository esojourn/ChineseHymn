    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "你若盼望救主常与你亲近，时时不离开你，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "永与你同行；你当牢记听从救主的命令，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "谦卑你心，和主同行。 你若谦卑，主必",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "和你常亲近；你若谦卑，必得喜乐的路径；",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "他决不能和骄傲的人同心，谦卑你心，和主同行。（阿们）",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s1_v2",
        "text": "古时圣贤先知常与神同在，真神降临和他",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "们相处往来；凡顺从神旨意，他保守疼爱，",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "谦卑你心，和主同行。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "和你常亲近；你若谦卑，必得喜乐的路径；",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "他决不能和骄傲的人同心，谦卑你心，和主同行。（阿们）",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s1_v3",
        "text": "正如河水总是往低处而流，圣洁的人亦必",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "蒙救主保佑；你快弃绝骄傲，悔改得拯救，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "谦卑你心，和主同行。",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "和你常亲近；你若谦卑，必得喜乐的路径；",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "他决不能和骄傲的人同心，谦卑你心，和主同行。（阿们）",
        "label": "第3段：第5谱行"
