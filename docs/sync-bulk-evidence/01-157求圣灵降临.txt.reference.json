        "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
        "performanceOrder": [
          {
            "region": "s1_v1",
            "text": "耶稣，每逢想念着主，愉快充满心怀，",
            "label": "第1段：第1谱行"
          },
          {
            "region": "s2_v1",
            "text": "若能到主面前安息，那是更加愉快！",
            "label": "第1段：第2谱行"
          },
          {
            "region": "s1_v2",
            "text": "有声难唱，有心难拟，记忆之中难寻，",
            "label": "第2段：第1谱行"
          },
          {
            "region": "s2_v2",
            "text": "能比人类救主圣名，更加甜蜜的名。",
            "label": "第2段：第2谱行"
          },
          {
            "region": "s1_v3",
            "text": "痛悔之心得着希望，柔和之心得恩，",
            "label": "第3段：第1谱行"
          },
          {
            "region": "s2_v3",
            "text": "倾跌之人如何蒙爱，寻者如何相逢！",
            "label": "第3段：第2谱行"
          },
          {
            "region": "s1_v4",
            "text": "寻着之人到底如何，笔墨何能描写！",
            "label": "第4段：第1谱行"
          },
          {
            "region": "s2_v4",
            "text": "耶稣之爱究竟如何，惟有爱心了解。",
            "label": "第4段：第2谱行"
          },
          {
            "region": "s1_v5",
            "text": "耶稣是我惟一快乐，是我将来赏赐，",
            "label": "第5段：第1谱行"
          },
          {
            "region": "s2_v5",
            "text": "现在荣光惟有我主，直到无穷尽时。，",
            "label": "第5段：第2谱行"
          }
        ],
