    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "基督宝架我所夸耀，巍然永立",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "宇宙间；一切圣迹光华普照，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "庄严灿烂亿万年。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s1_v2",
        "text": "生之颠危时来侵我，常多忧惧，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "多失望，主之宝架永不弃我，",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "常赐喜乐，赐安康。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s1_v3",
        "text": "生命真光时常辉耀，爱如好花",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "满蹊径，加上宝架光华荣耀，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "引我欣喜向前行。",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s1_v4",
        "text": "灾难、幸福、痛苦、欢愉，皆因宝架·",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "成为圣，此中平安何可言喻，",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "欢欣快乐永充盈。",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s1_v5",
        "text": "基督宝架我所夸耀，巍然永立",
        "label": "第5段：第1谱行"
      },
      {
        "region": "s2_v5",
        "text": "宇宙间；一切圣迹光华普照，",
        "label": "第5段：第2谱行"
      },
      {
        "region": "s3_v5",
        "text": "庄严灿烂亿万年。（阿们）",
        "label": "第5段：第3谱行"
      }
