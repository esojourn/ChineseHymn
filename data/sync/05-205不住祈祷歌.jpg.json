    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "不住祈祷因主是近，不住祈祷主全要听；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "真神应许决不失信， 不住 祈祷主必应 允。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s1_v2",
        "text": "不住祈祷凡百所需，不住祈祷主必赐予；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "无一求告主看太小，不住祈祷主都明了。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s1_v3",
        "text": "不住祈祷遇试探时，不住祈祷必能站立；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "主曾受试凡事体恤，不住祈祷主扶你。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s1_v4",
        "text": "不住祈祷若遇忧“愁，不住祈祷必蒙拯救；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "你心苦楚真神知道，不住祈祷主安排好。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s1_v5",
        "text": "不住祈祷当有信心，不住祈祷是最要紧；",
        "label": "第5段：第1谱行"
      },
      {
        "region": "s2_v5",
        "text": "信心能除忧愁伤心，不住祈祷主必答应。",
        "label": "第5段：第2谱行"
      }
    ],
