    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "真理圣灵在我心中，自由运行作善工；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "发出亮光，照耀，启示，使我识主并自己。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "充满我！充满我！耶稣，今来充满我！",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "荣耀圣灵今充满我愿主现今充满我！",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "完全倒空我这器皿污秽渣除干净；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "用主言语使我成圣，平安、喜乐，常得胜。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "充满我！充满我！耶稣，今来充满我！",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "荣耀圣灵今充满我愿主现今充满我！",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "有如渴鹿爱慕溪水我心渴慕主恩惠；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "活水江河愿主涌起自我心中流不息。，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "充满我！充满我！耶稣，今来充满我！",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "荣耀圣灵今充满我愿主现今充满我！",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "不是倚靠势力、才能，惟独仰赖主圣灵；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "心眼光明灵耳开通圣洁器皿合主用。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "充满我！充满我！耶稣，今来充满我！",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "荣耀圣灵今充满我愿主现今充满我！",
        "label": "第4段：第4谱行"
      }
