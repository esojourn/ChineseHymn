    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "恳求慈悲圣灵降下，·赐我安慰，光",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "照我灵，保我身心，指我方向，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "管我所作—切事情。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s1_v2",
        "text": "但愿赐光照我昏昧，能认主名，能",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "行主路，时时心存谦恭敬畏，",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "—刻不敢离开天父。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s1_v3",
        "text": "领我从主永生道路，非行此路，不",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "能归父，领我一心遵主诫命，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "不离我主妄行—步。",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s1_v4",
        "text": "但愿时常居我心中，令我得着天",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "上永福，在世给我平安喜乐，",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "在天永远心满意足。（阿们）",
        "label": "第4段：第3谱行"
      }
    ],
