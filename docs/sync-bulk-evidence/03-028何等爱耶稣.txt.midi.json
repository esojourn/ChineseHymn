  "performanceOrder": [
    {
      "region": "r1",
      "text": "我最喜爱唯一美名， 歌颂其价无比； 此名似乐悦耳动听， 此名美冠天地。",
      "label": "第1段"
    },
    {
      "region": "r2",
      "text": "我何等爱耶稣， 我何等爱耶稣， 我何等爱耶稣， 因耶稣先爱我。",
      "label": "第1段"
    },
    {
      "region": "r3",
      "text": "此名使我能知主爱， 舍命偿我罪债； 知主流血为我受害， 罪人唯此倚赖。",
      "label": "第2段"
    },
    {
      "region": "r4",
      "text": "我何等爱耶稣， 我何等爱耶稣， 我何等爱耶稣， 因耶稣先爱我。",
      "label": "第2段"
    },
    {
      "region": "r5",
      "text": "此名使我知道父神， 每天赐福丰盈； 我行之路虽然阴森， 有主恩光引领。",
      "label": "第3段"
    },
    {
      "region": "r6",
      "text": "我何等爱耶稣， 我何等爱耶稣， 我何等爱耶稣， 因耶稣先爱我。",
      "label": "第3段"
    },
    {
      "region": "r7",
      "text": "此名示我主爱深长， 能知我心痛苦； 担我忧愁分我悲伤， 世间无人比主。",
      "label": "第4段"
    },
    {
      "region": "r8",
      "text": "我何等爱耶稣， 我何等爱耶稣， 我何等爱耶稣， 因耶稣先爱我。",
      "label": "第4段"
    }
