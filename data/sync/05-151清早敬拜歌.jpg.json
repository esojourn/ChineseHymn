    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "清早敬拜神，周围皆安宁，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "鲜花欲开放，天色正微明，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "灵修境界好，与主交谈亲。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s1_v2",
        "text": "聆听主恩言，内心涌激情，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "主话路上光，主语脚前灯，",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "照我心明亮，导我步履正。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s1_v3",
        "text": "轻轻唱圣诗，鸟雀齐和鸣，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "甜美又温柔，欢欣又热诚，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "口唱心亦和，颂声主喜听。",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s1_v4",
        "text": "俯伏主足前，思量爱丰盛，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "赐我生命泉，信心力量增，",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "但愿寸草心，常念天父情。",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s1_v5",
        "text": "朝阳照行程，喜乐溢我灵，",
        "label": "第5段：第1谱行"
      },
      {
        "region": "s2_v5",
        "text": "恩主常扶持，生活能得胜，",
        "label": "第5段：第2谱行"
      },
      {
        "region": "s3_v5",
        "text": "爱神又爱人，善果好收成。（阿们）",
        "label": "第5段：第3谱行"
      }
    ],
