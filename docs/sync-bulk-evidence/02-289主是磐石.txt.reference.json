        "performanceOrder": [
          {
            "region": "s1_v1",
            "text": "主耶稣是我大磐石，我靠着主能得平安，",
            "label": "第1段：第1谱行"
          },
          {
            "region": "s2_v1",
            "text": "狂风大雨不能淋我，我靠着主能得平安。",
