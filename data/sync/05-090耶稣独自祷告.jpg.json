    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "耶稣独自为我祷告，在客西马尼园，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "他已为我独尝苦杯，面上汗流如血。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "为我！为我！他为我钉十架！",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "舍身流血还我罪债，他伤心是为我！为我！为",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "耶稣独自为我受审，在彼拉多庭前，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "他独自戴荆棘冠冕，为世人所轻看。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "为我！为我！他为我钉十架！",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "舍身流血还我罪债，他伤心是为我！为我！为",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "耶稣独自为我受死，在各各他山上，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "听他口中高声呼喊：“成了！成了！成了！”",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "为我！为我！他为我钉十架！",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "舍身流血还我罪债，他伤心是为我！为我！为",
        "label": "第3段：第4谱行"
      }
