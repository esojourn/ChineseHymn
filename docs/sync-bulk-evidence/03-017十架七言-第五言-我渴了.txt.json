  "performanceOrder": [
    {
      "region": "r1",
      "text": "得赎的人无一了解完全， 主用重价赎我回归羊圈， 为赎我罪竟然受伤如此， 轻轻声音，他说我渴了。",
      "label": "第1段"
    },
    {
      "region": "r2",
      "text": "主啊使我渐渐能明白， 你为我付出救赎大爱， 让我完全明白你爱不变， 也使我知道对你的亏欠。",
      "label": "第1段"
    },
    {
      "region": "r3",
      "text": "口中干渴虽然十分痛苦， 心灵饥渴远超所能描述， 内心深处发出沉重呼声， 从他口中，他诉说我渴了。",
      "label": "第2段"
    },
    {
      "region": "r4",
      "text": "主啊使我渐渐能明白， 你为我付出救赎大爱， 让我完全明白你爱不变， 也使我知道对你的亏欠。",
      "label": "第2段"
    }
  ],
