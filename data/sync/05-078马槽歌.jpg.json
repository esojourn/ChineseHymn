    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "远远在马槽里，无枕也无床，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "小小的主耶稣，睡觉很安康；",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "众明星都望着主睡的地方！",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "小小的主耶稣，睡在干草上。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "众畜鸣呜叫，圣婴忽惊醒，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "小小的主耶稣，却无啼哭声。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "我真爱小耶稣，敬求近我身，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "靠近我小床边，守我到天明。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "恭敬求主耶稣，靠近我身旁，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "爱护我，接受我，做主的小羊；",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "也保护众‘孩童，一齐都安康，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "教 我们都 能够跟主到天堂。",
        "label": "第3段：第4谱行"
      }
    ],
