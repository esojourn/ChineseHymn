    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "主耶稣再临那日必要吹起号简高声，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "那永远光明清新美丽早晨，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "凡世上得救的人必在那边一同相会，",
