    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "倚靠耶和华的人真有福，因他必随时蒙扶助，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "若要承受所应许的赏赐，必紧紧跟随主脚步。",
        "label": "第1段：第2谱行"
      },
