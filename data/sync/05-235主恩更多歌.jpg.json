  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "何等希奇一位救主，我所寻着乃主耶稣。",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "虽然我曾犯罪受苦，主赐恩典真正无数。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "主恩实在更多，主恩实在更多，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我罪虽多主血涂抹，主恩实在更多。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "我靠自已毫无功劳，惟独救主为我义袍。",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "所流宝血出于天羔，能洗罪迹不剩丝毫。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "主恩实在更多，主恩实在更多，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我罪虽多主血涂抹，主恩实在更多。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "救主是我赎罪羔羊，又是先知、祭司、君王。",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "赦罪恩典赏赐无量，一切托主全能担当。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "主恩实在更多，主恩实在更多，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我罪虽多主血涂抹，主恩实在更多。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "我主尊名总要颂赞，我灵情愿，歌唱不停。",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "赞美主爱极大无边，世世代代永无穷尽。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "主恩实在更多，主恩实在更多，",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我罪虽多主血涂抹，主恩实在更多。",
        "label": "第4段：第4谱行"
      }
    ],
