    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "赞美上帝，为我们完成了救赎，我众来到",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "主面前，献上礼物；虔诚供奉主前，屈",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "膝敬拜不止，来感谢主圣名，欢唱赞美",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s1_v2",
        "text": "先贤之神，恳求你听我们倾诉，蒙主引导",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "经试炼，风波安渡；每当患难临头，主",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "必引领出险，生活能够得胜，全靠主帮",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s1_v3",
        "text": "敬献颂赞，有救主为我们引路，真诚感谢",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "颂扬主，我众欢呼；因主在我身旁，有",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "主膀臂护卫，我们感谢歌唱，永远赞美",
        "label": "第3段：第3谱行"
      }
