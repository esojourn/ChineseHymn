  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "在昔日我主为罪人降生，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "撇荣冕离天上宝位；在大卫之城，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "一穷苦马 棚，有空 处是为主预备。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "求来到我心，主耶稣，在我心有空处为你；",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_v1",
        "text": "求来到我心，主耶稣来，在我心有空处为你。",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s1_v2",
        "text": "狐狸尚有洞，飞鸟亦有巢，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "困乏时得安然居住；惟我主耶稣，",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "顺父旨勤劳，在世间无枕首之处。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "求来到我心，主耶稣，在我心有空处为你；",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_v2",
        "text": "求来到我心，主耶稣来，在我心有空处为你。",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s1_v3",
        "text": "主赐人生命，救人脱罪权，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "真如同解锁链一样；人却戏笑主，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "加以荆棘冠，且钉主在苦架之上。",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "求来到我心，主耶稣，在我心有空处为你；",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s5_v3",
        "text": "求来到我心，主耶稣来，在我心有空处为你。",
        "label": "第3段：第5谱行"
      },
      {
        "region": "s1_v4",
        "text": "何时唱凯歌，声音满于天，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "来欢迎极荣耀君王；但愿听闻主",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "慈声 对我 说：我为 你已预备地 方。",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_v4",
        "text": "当主荣耀再降临时，盼望主这样召呼我；",
        "label": "第4段：第4谱行"
      },
      {
        "region": "s5_v4",
        "text": "当 主荣耀再降临时候，盼望主这样召呼我。 ",
        "label": "第4段：第5谱行"
      }
    ],
