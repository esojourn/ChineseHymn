    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "前要的是祝福，今要主自己；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "前要的是医治，今惟主而已；",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "前我贪求恩赐，今要赐恩者；",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": ".前我寻求能力，今要全能者。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "永远举起耶稣，赞美主不歇，",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "—一切在耶稣里，主是我切。",
        "label": "第1段：第6谱行"
      },
      {
        "region": "s1_v2",
        "text": "前常用手拉主，今主手牵我；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "前常无所适从，今抛锚稳妥；",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "前要的是感觉，今凭主口说；",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "前是频频苦试，今完全信托。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "永远举起耶稣，赞美主不歇，",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "—一切在耶稣里，主是我切。",
        "label": "第2段：第6谱行"
      },
      {
        "region": "s1_v3",
        "text": "前是忙于打算，今则靠祈求；·",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "前是悬切挂虑，今主担我忧；",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "前随我之所欲，今听主支配；",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "前不住的求讨，今不断赞美。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "永远举起耶稣，赞美主不歇，",
        "label": "第3段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "—一切在耶稣里，主是我切。",
        "label": "第3段：第6谱行"
      },
      {
        "region": "s1_v4",
        "text": "前我欲利用主，今则主用我；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "前藉自已作工，今靠主工作；",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "前欲得人称赞，今求主欢喜；",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_v4",
        "text": "我所有的—切，都在主自己。",
        "label": "第4段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "永远举起耶稣，赞美主不歇，",
        "label": "第4段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "—一切在耶稣里，主是我切。",
        "label": "第4段：第6谱行"
      }
    ],
