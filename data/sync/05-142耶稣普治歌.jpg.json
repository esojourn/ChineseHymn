  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "日月所照万国万方，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "耶稣必为统治君王；",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "東1.南北西东，主治普及，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "千秋万古，悠久无疆。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "不這绝祷声這向他這奉献，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "无量颂歌成他冠冕；",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "到处圣名好比馨香，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "随.同晨祭，上升于天。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "万方、万国、万族、万民，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "不停颂赞妙爱奇恩；",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "婴孩亦将同声歌唱，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "及早颂扬救主圣名。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "在主治下人個人多個福：",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "罪人跳出捆绑束缚，",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "劳人获得永恒難安難乐，",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_v4",
        "text": "贫人获得丰盈富足。",
        "label": "第4段：第4谱行"
      },
      {
        "region": "s1_v5",
        "text": "受造群生這皆当兴起，",
        "label": "第5段：第1谱行"
      },
      {
        "region": "s2_v5",
        "text": "特殊荣耀向主献呈；",
        "label": "第5段：第2谱行"
      },
      {
        "region": "s3_v5",
        "text": "天使再来高声歌唱，",
        "label": "第5段：第3谱行"
      },
      {
        "region": "s4_v5",
        "text": "地上万民同应“阿们”。",
        "label": "第5段：第4谱行"
      }
    ],
