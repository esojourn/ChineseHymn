    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "不再是我，乃是主被人相信，被人高举，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "又被人所爱敬，无论思想、言语态度或动作，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "不再是我,乃是显出基督。不再是我，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "乃是基督，基督永远不改变！",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "在荣耀中，基督是中心，基督王位永存不变。（阿们）",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s1_v2",
        "text": "不再自夸，乃是夸赞主基督，不再自傲，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "乃是尊重基督；求主使我不再自负或自怜，",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "随时随在没有自我表现。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "乃是基督，基督永远不改变！",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "在荣耀中，基督是中心，基督王位永存不变。（阿们）",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s1_v3",
        "text": "惟独基督是我供给的来源，惟独基督",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "是我能力源泉，惟有基督与我身心灵相联，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "惟独基督从此直到永远。",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "乃是基督，基督永远不改变！",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "在荣耀中，基督是中心，基督王位永存不变。（阿们）",
        "label": "第3段：第5谱行"
      },
      {
        "region": "s1_v4",
        "text": "惟独基督是我一生的盼望，惟独基督",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "使我见主荣光，惟有基督使我永远得满足，",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "惟独基督是我极大宏福。",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "乃是基督，基督永远不改变！",
        "label": "第4段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "在荣耀中，基督是中心，基督王位永存不变。（阿们）",
        "label": "第4段：第5谱行"
