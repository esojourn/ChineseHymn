  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "我曾被罪恶锁链所捆绑，真是不自由，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "痛苦难当，但耶稣断开我一切锁链，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "荣耀的救恩使我释放。 荣耀的释放，奇妙的",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "释放，我再无罪恶束缚捆绑。 荣耀释放者",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "是救主耶稣，从今到永远，使我释放。（阿们）",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s1_v2",
        "text": "主使我脱离情欲和嗜好，脱离我妒忌、",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "恨恶、狂傲，脱离我世俗虚空的幻想，",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "亦使我离去—切烦恼。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "释放，我再无罪恶束缚捆绑。 荣耀释放者",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "是救主耶稣，从今到永远，使我释放。（阿们）",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s1_v3",
        "text": "主使我脱离骄傲和愚昧，脱离我沉溺",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "金钱迷惑，脱离我恼怒暴躁的性情，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "荣耀的释放，无穷喜乐。．",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "释放，我再无罪恶束缚捆绑。 荣耀释放者",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "是救主耶稣，从今到永远，使我释放。（阿们）",
        "label": "第3段：第5谱行"
      }
    ],
