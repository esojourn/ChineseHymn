  "independentTimelines": {
    "05-316助我进深歌.mp3": {
      "definitions": [
        {
          "region": "s1_v1",
          "text": "进深！进深，进入主爱深渊，每日更进深；",
          "label": "第1段：第1谱行"
        },
        {
          "region": "s2_v1",
          "text": "登高！登高！效主智慧完全，更知主恩深。",
          "label": "第1段：第2谱行"
        },
        {
          "region": "s3_chorus",
          "text": "求難主助我进深！我這愿不断长进！層",
          "label": "第1段：第3谱行"
        },
        {
          "region": "s4_chorus",
          "text": "赐我聪明智慧，领我进入真理。",
          "label": "第1段：第4谱行"
        },
        {
          "region": "s1_v2",
          "text": "进深！进深，直趋保惠恩师，时刻受启示；",
          "label": "第2段：第1谱行"
        },
        {
          "region": "s2_v2",
          "text": "生命必需与主合而为一，实行旨意。",
          "label": "第2段：第2谱行"
        },
        {
          "region": "s3_chorus",
          "text": "求難主助我进深！我這愿不断长进！層",
          "label": "第2段：第3谱行"
        },
        {
          "region": "s4_chorus",
          "text": "赐我聪明智慧，领我进入真理。",
          "label": "第2段：第4谱行"
        },
        {
          "region": "s1_v3",
          "text": "进深！进深，虽经艰难试炼，还向标竿行；",
          "label": "第3段：第1谱行"
        },
        {
          "region": "s2_v3",
          "text": "根基稳固在主圣洁里面，必有好收成。",
          "label": "第3段：第2谱行"
        },
        {
          "region": "s3_chorus",
          "text": "求難主助我进深！我這愿不断长进！層",
          "label": "第3段：第3谱行"
        },
        {
          "region": "s4_chorus",
          "text": "赐我聪明智慧，领我进入真理。",
          "label": "第3段：第4谱行"
        },
        {
          "region": "s1_v4",
          "text": "进深!进深，每日跟主脚步，行走得胜路；",
          "label": "第4段：第1谱行"
        },
        {
          "region": "s2_v4",
          "text": "身心满有耶稣荣耀形状，真为基督徒。",
          "label": "第4段：第2谱行"
        },
        {
          "region": "s3_chorus",
          "text": "求難主助我进深！我這愿不断长进！層",
          "label": "第4段：第3谱行"
        },
        {
          "region": "s4_chorus",
          "text": "赐我聪明智慧，领我进入真理。",
          "label": "第4段：第4谱行"
