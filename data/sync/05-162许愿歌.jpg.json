  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "耶稣啊，我曾应许，永远服事我主；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "我主啊，我的朋友，常求与我相聚；",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "主若时常在我旁，我将奋斗不惧；",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "主若时常前引路，我便随从无虑。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "我既生存在世间，容我知主邻近；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "我见迷乱的景物，听见诱惑声音；",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "我生身外同心内，常有仇敌相侵；",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "但望耶稣与我亲，将我灵魂保存。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "永发慈悲语音啊，容我清楚听闻；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "狂情火欲风涛上，浮有刚之音；",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "请用圣言印证我，使我进退遵循；",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "护持我灵的主啊，你声使我听闻。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "耶稣啊，主曾应许，一切随从的人，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "主在何处得荣耀，何处有主仆人；",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "耶稣啊，我曾应许，永远服事殷勤；",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_v4",
        "text": "我主啊，我的朋友，赐我恩惠依循。",
        "label": "第4段：第4谱行"
      }
    ],
