  "performanceOrder": [
    {
      "region": "r1",
      "text": "主耶和华求祢领我， 走过今世旷野路， 我无力量主有能力， 愿主圣手常保护。",
      "label": "第1段"
    },
    {
      "region": "r2",
      "text": "天上吗哪，天上吗哪， 求主时常赐给我， 求主时常赐给我。",
      "label": "第1段"
    },
    {
      "region": "r3",
      "text": "求主开通永生泉源， 使我路中不干渴， 求主做我云柱火柱， 引我前路不走错。",
      "label": "第2段"
    },
    {
      "region": "r4",
      "text": "全能救主，全能救主， 做我盾牌保护我， 做我盾牌保护我。",
      "label": "第2段"
    },
    {
      "region": "r5",
      "text": "当我走到约旦河畔， 烦恼惊慌全消散， 救主已经胜过死权， 我靠救主也得胜。",
      "label": "第3段"
    },
    {
      "region": "r6",
      "text": "赞美歌颂，赞美歌颂， 我要高唱永不停， 我要高唱永不停。",
      "label": "第3段"
    }
  ],
