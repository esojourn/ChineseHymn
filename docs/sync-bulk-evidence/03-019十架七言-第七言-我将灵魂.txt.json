  "performanceOrder": [
    {
      "region": "r1",
      "text": "地暗天昏，磐石崩裂，众人皆惊惶。 我主气将尽，十字架上；我救主他大声说：",
      "label": "第1段"
    },
    {
      "region": "r2",
      "text": "父啊！父啊！我将灵魂， 我将我的灵魂交在你的手里。 天色渐暗，生命将近， 说完这句话，我救主就死了。",
      "label": "第1段"
    },
    {
      "region": "r3",
      "text": "天地震动，圣殿幔子，裂开成两片。 死亡的阴影，笼罩我主，十架上他大声说：",
      "label": "第2段"
    },
    {
      "region": "r4",
      "text": "父啊！父啊！我将灵魂， 我将我的灵魂交在你的手里。 天色渐暗，生命将近， 说完这句话，我救主就死了。",
      "label": "第2段"
    }
  ],
