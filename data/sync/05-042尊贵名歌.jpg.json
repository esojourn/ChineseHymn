    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "忧苦弟兄内心软弱，该常记念耶稣名；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "靠着救主犹如磐石，忧虑就全变安稳。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "尊贵名，何等美！地所望与天所爱。尊贵名，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "何等美！地所望与天所爱。（阿们）",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "常用耶稣名字思念，可当盾牌保护心。",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "魔鬼万般引诱危险， 祷告耶稣全得胜。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "尊贵名，何等美！地所望与天所爱。尊贵名，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "何等美！地所望与天所爱。（阿们）",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "耶稣名字真是奇珍，使我灵魂大高兴。",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "主伸爱手来接罪人，应该歌唱主圣名。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "尊贵名，何等美！地所望与天所爱。尊贵名，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "何等美！地所望与天所爱。（阿们）",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "听得主名全要跪拜，在主脚下俯伏身；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "天地主宰永远赞美，救主永远受尊称。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "尊贵名，何等美！地所望与天所爱。尊贵名，",
        "label": "第4段：第3谱行"
