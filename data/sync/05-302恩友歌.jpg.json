  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "何等恩友慈仁救主，负我罪孽担我忧；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "何等权利能将万事，来到耶稣座前求！",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "多少平安我们坐失，多少痛苦冤枉受，，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "都是因为未将万事，来 到耶稣座前求。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "我们有无试探引诱？有无难过苦关头？",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "决不应当因此灰心，仍当到主座前求！",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "何处能寻这般良友，同尝一切苦与愁？",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "我们弱点主都知道，放心到主座前求。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "我们是否软弱多愁，千斤重担压肩头？",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "主仍做我避难处所，奔向耶稣座前求！",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "你若真逢友叛亲离，好向耶稣座前求！",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "到他怀中他必保护，有他安慰便无忧。",
        "label": "第3段：第4谱行"
      }
    ],
