    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "耶稣再来奖赏他众仆人，或在正午或夜间，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "你我可曾时刻做醒等候，灯盏明亮油满添？",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "你能否说：“生啊，我已预备，光明天家我能进！”",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "主来时候我们是否醒，欢喜等候迎接主来临？",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "若主耶稣降临时在清晨，一一呼唤我众人，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "所有工程都要向主面陈，但愿主夸“好仆人”！",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "你能否说：“生啊，我已预备，光明天家我能进！”",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "主来时候我们是否醒，欢喜等候迎接主来临？",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "主所托付各样大小事情，我们是否尽忠心？",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "若我作工存着无亏良心，就能享永久安宁。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "你能否说：“生啊，我已预备，光明天家我能进！”",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "主来时候我们是否醒，欢喜等候迎接主来临？",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "时常等候主的必有福份，得进入荣耀欢欣，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "主来时候无论半夜黎明，我们能否常醒？",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "你能否说：“生啊，我已预备，光明天家我能进！”",
