    "performanceOrder": [
      {
        "region": "system1",
        "text": "开我眼睛使我看见神的真理为我彰显",
        "label": "第1段：第一谱行"
      },
      {
        "region": "system2",
        "text": "求将奇妙秘钥交我手解除捆锁使我自由",
        "label": "第1段：第二谱行"
      },
      {
        "region": "chorus1",
        "text": "我今安静专心等候惟愿我主旨意成就",
        "label": "第1段：副歌上半"
      },
      {
        "region": "chorus2",
        "text": "恳求圣灵开我眼睛光照引领",
        "label": "第1段：副歌下半"
      },
      {
        "region": "system1",
        "text": "开我耳朵使我听见恩主所赐真理之言",
        "label": "第2段：第一谱行"
      },
      {
        "region": "system2",
        "text": "当此佳音荡漾我耳中一切虚伪顿失影踪",
        "label": "第2段：第二谱行"
      },
      {
        "region": "chorus1",
        "text": "我今安静专心等候惟愿我主旨意成就",
        "label": "第2段：副歌上半"
      },
      {
        "region": "chorus2",
        "text": "恳求圣灵开我眼睛光照引领",
        "label": "第2段：副歌下半"
      },
      {
        "region": "system1",
        "text": "开我的口能尝主恩见证真理满有热忱",
        "label": "第3段：第一谱行"
      },
      {
