    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "我们当来同声欢呼，称颂神的基督；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "我们若有千万舌头，新歌只有一首。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s1_v2",
        "text": "“升天羔羊，你真是配来得这样赞美！”",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "我们喊说：你真是配，因你为我降卑！”",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s1_v3",
        "text": "救主耶稣配得尊贵、权柄、荣耀、智慧；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "还有许多不及献上，永归被杀羔羊！",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s1_v4",
        "text": "不久圣徒快要上升，同发赞美之声；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "天地、宇宙、高山、沧海，都要赞美敬拜！",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s1_v5",
        "text": "圣徒欢聚新天新地，颂赞羔羊不已；",
        "label": "第5段：第1谱行"
      },
      {
        "region": "s2_v5",
        "text": "因他降世，亲历死地，现今荣耀无比。",
        "label": "第5段：第2谱行"
      }
    ],
