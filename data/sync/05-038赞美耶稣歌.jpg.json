  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "赞美！赞美！耶稣我亲爱的救主，全地歌唱",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "主的妙爱显明。 天使、天军高声赞美慈悲",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "救主，尊贵、荣耀都归我主圣名！耶稣引导，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "如同牧人领小羊，因主终日怀抱他众子民。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "永远歌唱，颂扬主名万代！（阿们）",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s1_v2",
        "text": "赞美！赞美！耶稣我慈悲的救主，为人罪过",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "受苦流血舍身。主是磐石，我心所爱慕的",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "救主,赞美!赞美!十架救赎洪恩。高声 歌唱，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "因主担当我愁闷，无限慈悲，奇妙爱何等深！",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "永远歌唱，颂扬主名万代！（阿们）",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s1_v3",
        "text": "赞美！赞美！耶稣我永远的羔羊，天上圣众",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "和散那高声唱！耶稣救主做我们和平的",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "君王，加冕于主，先知祭司君王。基督再来，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "万民屈膝恭敬拜，荣耀权能都归我主我王。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "永远歌唱，颂扬主名万代！（阿们）",
        "label": "第3段：第5谱行"
      }
    ],
