    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "我乃属耶稣，我听闻主声，主恩爱充满我心；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "今求赐信心，靠赖主膀臂，常与主相近相亲。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "更亲近主，亲近我恩主，来到主受死圣架！",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "更亲近主，近主，亲近我恩主，到主流血宝架",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "今归主为圣，专为主所用，每日蒙新赐天恩；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "信望爱日增，口不住称颂，按主旨意度一生。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
