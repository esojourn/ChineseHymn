  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "欢乐平安之佳日，辉煌快乐良辰，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "劳苦忧愁的安慰，无边美丽光明；",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "万国万民齐歌唱，万世乐声谐应，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "唱“圣哉，圣哉，圣哉！\"赞美三一至尊。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "此日上主行创造，光明奉命而生；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "此日救主曾复活，救赎世界罪人；",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "此日得胜之救主，从天降下圣灵；",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "惟赖此日之光荣，主赐三种光明。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "不绝赐来新恩典，安息之日欢欣，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "我灵希望享安息，永远蒙福天庭。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "教会众人称颂主，圣父、圣子、圣灵；",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "一致同声高歌唱，赞美三一至尊。（阿们）",
        "label": "第3段：第4谱行"
      }
    ],
