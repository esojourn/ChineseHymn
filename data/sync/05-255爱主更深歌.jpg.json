    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "切愿爱主更深，更深爱称！",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "我今屈膝求恳，成此心意。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "这是衷心渴慕，爱你更深，我主，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": ".爱主更深！爱主更深！",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "前我追求荣禄、安闲、逍遥，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "今只寻求基督，福份上好。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "这是惟-渴慕，爱你更深，我主，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "爱主更深！爱主更深！",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "忧伤尽可施威，横加苦痛；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "但你使者何美，带来歌颂，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "与我同声唱出，爱你更深，我主，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "爱主更深！爱主更深！",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "至终呼吸短促，歌声轻微，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "我心仍要发出祷告赞美。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "我心仍是渴慕，爱你更深，我主，",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_v4",
        "text": "爱主更深！爱主更深！（阿们）",
        "label": "第4段：第4谱行"
      }
    ],
