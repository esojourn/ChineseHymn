    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "我心依傍主十架，在彼有生命泉，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "基督宝血已流出，洗我万众罪您。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "十字架，十字架，永是我的荣耀，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我众罪都洗清洁，惟靠耶稣宝血。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "十架旁我信虽小，救主总不丢弃，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "他赐下圣灵亮光，照我昏昧心里。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "十字架，十字架，永是我的荣耀，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我众罪都洗清洁，惟靠耶稣宝血。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "十架旁我祈求主，默念羔羊宏恩，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "每日不论往何处，靠主十架指引。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "十字架，十字架，永是我的荣耀，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我众罪都洗清洁，惟靠耶稣宝血。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "十架旁我心仰望，时刻做醒祈祷，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "敬虔等候主再来，同得天上荣耀。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "十字架，十字架，永是我的荣耀，",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我众罪都洗清洁，惟靠耶稣宝血。",
        "label": "第4段：第4谱行"
