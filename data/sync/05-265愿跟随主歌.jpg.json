    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "我愿意跟随耶稣走平坦道路，或在花木茂盛",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "清水常流之处；既有救主在前引导，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "我愿跟随主，一路走到天上，紧跟主脚步。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "跟随，跟随，我愿跟随耶稣，无论往何地方，",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "我愿跟随主；跟随，跟随，我愿跟随耶稣，",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "只望耶稣引导,我愿跟随主！（阿们）",
        "label": "第1段：第6谱行"
      },
      {
        "region": "s1_v2",
        "text": "我愿意跟随耶稣走崎岖道路，或遭风雨交作，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "黑云把路拦阻，既有救主在前引导，",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "我永不惊慌，总不惧怕危险，因有主相助。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "跟随，跟随，我愿跟随耶稣，无论往何地方，",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "我愿跟随主；跟随，跟随，我愿跟随耶稣，",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "只望耶稣引导,我愿跟随主！（阿们）",
        "label": "第2段：第6谱行"
      },
      {
        "region": "s1_v3",
        "text": "我愿意跟随耶稣走任何道路，我愿与主同行，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "时常蒙主保护；如今我所走的路程，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "主早已经过，主必领我进那应许光明处。",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
