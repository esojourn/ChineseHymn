    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "脱离捆绑、忧愁与黑影，耶稣，我来！耶稣，我来！",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "进入自由、喜乐与光明，耶稣，我来就你！，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "脱离疾病，进入你完全；脱离贫乏，进入你丰满；",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "脱离罪恶，得见你圣颜，耶稣,我来就你！",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "脱离羞耻、失败与亏欠，耶稣，我来！耶稣，我来！",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "进入十架荣耀的恩泉，耶稣，我来就你！",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "脱离痛苦，进入你安宁；脱离风波，进入你平静；",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "脱离怨叹，进入你欢欣，耶稣，我来就你！",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "脱离狂傲、不平的血气，耶稣，我来！耶稣，我来！",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "进入完全、有福的旨意，耶稣，我来就你！",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "脱离自己，住在你爱里；脱离绝望，等候你来提，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "离地上腾，如鹰展双翼，耶稣，我来就你！",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "脱离幽暗阴府的可怕，耶稣，我来！耶稣，我来！",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "进入欢乐、光明的父家，耶稣，我来就你！",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "脱离败坏、无底的深渊，进入护庇、安歇的羊圈，",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_v4",
        "text": "永永远远瞻仰你荣颜，耶稣，我来就你！",
        "label": "第4段：第4谱行"
      }
