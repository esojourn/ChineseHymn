    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "天上今有欢声，那里有喜乐，因为有人离开罪恶路；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "慈父亲自迎接，欢然来相会，因为有人归向主耶稣。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "哈利路亚，天使高声唱！哈利路亚，琴声多悠扬！",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "蒙救赎的圣徒列队向前行，高唱得胜诗歌多亮！",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "天上今有欢声，那里有喜乐，因有罪人与上帝和好；",
        "label": "第2段：第1谱行"
      },
      {
