    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "我灵，镇静：上主在你一方：",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "忧痛十架，你要忍耐担当；",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "但凭上帝为你吩咐主张：",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "万变之中，惟主忠实永长。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_v1",
        "text": "我灵，镇静：天友最是善良，",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s6_v1",
        "text": "经过荆棘，引到欢乐地方。",
        "label": "第1段：第6谱行"
      },
      {
        "region": "s1_v2",
        "text": "我是镇静，亡主决然担年",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "未来引极们过走情形",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "意让荷事摇你希望信心：",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "目前奥桦待启必成光明",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_v2",
        "text": "我录镇静，风浪依侣品遵",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s6_v2",
        "text": "救主当年所发盼附声音",
        "label": "第2段：第6谱行"
      },
      {
        "region": "s1_v3",
        "text": "我灭，镇静：右因离别接谨，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "若任泊谷，四顾黑暗汇汇，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "此时更见我王慈爱深长，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "亲来女感，使你停止惩伤。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s5_v3",
        "text": "我灭，镇静：臭优所失所汇，",
        "label": "第3段：第5谱行"
      },
      {
        "region": "s6_v3",
        "text": "王恩丰蔓口后员累。、",
        "label": "第3段：第6谱行"
      },
      {
        "region": "s1_v4",
        "text": "我灵，镇静：日月过去如飞，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "到时我众，永能在主周围，",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "失望惊惶完全消踪火迹，",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_v4",
        "text": "忧愁忘记，纯爱之乐复回。",
        "label": "第4段：第4谱行"
      },
      {
        "region": "s5_v4",
        "text": "我灵，镇静：世变泪痕既逝，",
        "label": "第4段：第5谱行"
      },
      {
        "region": "s6_v4",
        "text": "我众欢聚，大家平安永憩。，（阿们）",
        "label": "第4段：第6谱行"
      }
    ],
