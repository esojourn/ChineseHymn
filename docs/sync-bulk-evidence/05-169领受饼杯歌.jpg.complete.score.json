  "sourceHash": "a08b8d56db3499b44b3cc6b6ada5b01f7664cf5091e49e2b2d175e9912d7b302",
  "trackHashes": [
    {
      "file": "05-169领受饼杯歌.mp3",
      "sha256": "df8f02266cba13e95ecadd77a1c7a2dc0b6154df49c52da0046b7dcc7825aba2"
    }
  ],
  "performanceOrder": [
    {
      "region": "s1_v1",
      "text": "为着这饼和这杯，为着神子曾降卑，",
      "label": "第1段：第1谱行"
    },
    {
      "region": "s2_v1",
      "text": "为着神恩如雨沛，主，我们感谢你。",
      "label": "第1段：第2谱行"
    },
    {
      "region": "s1_v2",
      "text": "依然是酒依然饼，藉此信心却看明，",
      "label": "第2段：第1谱行"
    },
    {
      "region": "s2_v2",
      "text": "爱心神圣的小影，主，我们感谢你。",
      "label": "第2段：第2谱行"
    },
    {
      "region": "s1_v3",
      "text": "为着你曾召我们，举目仰望你救恩，",
      "label": "第3段：第1谱行"
    },
    {
      "region": "s2_v3",
      "text": "藉着信心近你身，主，我们感谢你。",
      "label": "第3段：第2谱行"
    },
    {
      "region": "s1_v4",
      "text": "为着你曾发命令，要我纪念你所行，",
      "label": "第4段：第1谱行"
    },
    {
      "region": "s2_v4",
      "text": "何等温柔何等贫，主，我们感谢你。",
      "label": "第4段：第2谱行"
    },
    {
      "region": "s1_v5",
      "text": "为着你曾用慈爱，引我想家在天外，",
      "label": "第5段：第1谱行"
    },
    {
      "region": "s2_v5",
      "text": "“行此直等到我来”，主，我们感谢你。",
      "label": "第5段：第2谱行"
    },
    {
      "region": "s1_v6",
      "text": "直到他来我壁饼，表明他作我生命，",
      "label": "第6段：第1谱行"
    },
    {
      "region": "s2_v6",
      "text": "为我睡了为我醒，主，我们感谢你。",
      "label": "第6段：第2谱行"
    },
    {
      "region": "s1_v7",
      "text": "直到他来我饮杯，表明他赐福全备，",
      "label": "第7段：第1谱行"
    },
    {
      "region": "s2_v7",
      "text": "使我站在新地位，主，我们感谢你。",
      "label": "第7段：第2谱行"
    },
    {
      "region": "s1_v8",
      "text": "为着再来的嘱咐，为着那日快见主，",
      "label": "第8段：第1谱行"
    },
    {
      "region": "s2_v8",
      "text": "为着荣耀和国度， 主，我们感谢你。",
      "label": "第8段：第2谱行"
    }
  ],
