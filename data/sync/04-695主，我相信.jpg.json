    "performanceOrder": [
      {
        "region": "system1",
        "text": "当我在征途上遇见试探时撒但就在耳语叫",
        "label": "第1段：第一谱行"
      },
      {
        "region": "system2",
        "text": "我可放弛但是负担虽重我已不发愁只",
        "label": "第1段：第二谱行"
      },
      {
        "region": "system3",
        "text": "要一点相信就敢向前走主我相信主我相信",
        "label": "第1段：第三谱行及副歌开头"
      },
      {
        "region": "chorus2",
        "text": "求提高我信你的心使我能以移山主我相信",
        "label": "第1段：副歌第二行"
      },
      {
        "region": "chorus3",
        "text": "主我相信我的疑虑全投在你身畔",
        "label": "第1段：副歌末行"
      },
      {
        "region": "system1",
        "text": "当我航行海上风顺的时候何等容易相信耶",
        "label": "第2段：第一谱行"
      },
      {
        "region": "system2",
        "text": "和华的手但我发现正当波浪漫船来需",
        "label": "第2段：第二谱行"
      },
      {
        "region": "system3",
        "text": "要好多相信才能不沉埋主我相信主我相信",
        "label": "第2段：第三谱行及副歌开头"
      },
      {
        "region": "chorus2",
        "text": "求提高我信你的心使我能以移山主我相信",
        "label": "第2段：副歌第二行"
      },
      {
        "region": "chorus3",
        "text": "主我相信我的疑虑全投在你身畔",
        "label": "第2段：副歌末行"
      },
      {
        "region": "system1",
        "text": "我常听人说我要坚持到底我要忠心至死我",
        "label": "第3段：第一谱行"
      },
      {
        "region": "system2",
        "text": "绝不逃避但当试探来得特别凶猛时他",
        "label": "第3段：第二谱行"
      },
      {
        "region": "system3",
        "text": "就停止相信什么都丧失主我相信主我相信",
        "label": "第3段：第三谱行及副歌开头"
      },
      {
        "region": "chorus2",
        "text": "求提高我信你的心使我能以移山主我相信",
        "label": "第3段：副歌第二行"
      },
      {
        "region": "chorus3",
        "text": "主我相信我的疑虑全投在你身畔",
        "label": "第3段：副歌末行"
      },
      {
        "region": "system1",
        "text": "还有别人满有勇敢与热心他们参加事奉如",
        "label": "第4段：第一谱行"
      },
      {
        "region": "system2",
        "text": "同钢铁人但是正当与罪摔跤最热时他",
        "label": "第4段：第二谱行"
      },
      {
        "region": "system3",
        "text": "们不是相信乃是怕损失主我相信主我相信",
        "label": "第4段：第三谱行及副歌开头"
      },
      {
        "region": "chorus2",
        "text": "求提高我信你的心使我能以移山主我相信",
        "label": "第4段：副歌第二行"
      },
      {
        "region": "chorus3",
        "text": "主我相信我的疑虑全投在你身畔",
        "label": "第4段：副歌末行"
      },
      {
        "region": "system1",
        "text": "但愿我们记得在属灵生活信心不是感觉信",
        "label": "第5段：第一谱行"
      },
      {
        "region": "system2",
        "text": "靠非抚摸正当一切好像最看不见时我",
        "label": "第5段：第二谱行"
      },
      {
        "region": "system3",
        "text": "们仍要相信因而仍坚持主我相信主我相信",
        "label": "第5段：第三谱行及副歌开头"
      },
      {
        "region": "chorus2",
        "text": "求提高我信你的心使我能以移山主我相信",
        "label": "第5段：副歌第二行"
      },
      {
        "region": "chorus3",
        "text": "主我相信我的疑虑全投在你身畔",
        "label": "第5段：副歌末行"
      }
