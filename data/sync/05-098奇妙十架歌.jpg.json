    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "每逢思想奇妙十架，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "铭感救恩，虔诚顶礼；",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "从前所慕势利虚荣，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "如今愿意完全抛弃。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "觐见宝架，仰瞻圣范，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "愛2.寸心了解救恩浩大；",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "莫容我为别事矜夸，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "生死安危，惟夸十架。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "试问众生曾否時见过，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "長3.忧層愁慈層爱和層血傘并層流？層",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "愛3.愁層爱可層曾層如層此層相層接？層",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "荆棘可曾化作冕？",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "救主慈爱，无·限高深，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "尽献所有，难报主恩；",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "愿负十架，学主栖牲，",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_v4",
        "text": "喝主苦杯，效主求仁。（阿们）",
        "label": "第4段：第4谱行"
      }
    ],
