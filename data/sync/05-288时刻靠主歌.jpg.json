    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "我平时当靠救主，遇患难求主救护；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "我信心虽还不足，惟要靠我主领路。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "靠耶稣渡过今世，靠耶稣能行万事。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我不论走何险路，惟要信靠我救主。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "求圣灵照亮我心，叫我心满得光明；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "求救主领我正路，惟要靠我主保护。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "靠耶稣渡过今世，靠耶稣能行万事。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我不论走何险路，惟要信靠我救主。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "路平安当颂主名，路黑暗有主同行；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "若危险主必保护，惟要靠我主领路。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "靠耶稣渡过今世，靠耶稣能行万事。",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我不论走何险路，惟要信靠我救主。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "靠耶稣渡过今世，靠耶稣能行万事；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "我离世即往天府，惟要靠耶稣救主。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_chorus",
