    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "有平安在我心，非世界所能赐，无人能夺",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "去这平安；虽试炼与艰难，犹如愁云环",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "绕，我心里永远有这平安。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "永远在我心里，耶稣属我！",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "永远在我心里，无上快難乐！",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "主永远不撇下我，慈声对我说：",
        "label": "第1段：第6谱行"
      },
      {
        "region": "s7_chorus",
        "text": "“我总不离开你。”耶稣属我！（阿们）",
        "label": "第1段：第7谱行"
      },
      {
        "region": "s1_v2",
        "text": "当平安来我心，普世界都赞美，颂扬我救",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "主大君王；诸愁苦皆飞去，阴沉将变辉",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "煌，福哉，主耶稣荣耀真光。",
        "label": "第2段：第3谱行"
