    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "神未曾应许：天色常蓝，人生的路途花香常漫；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "神未曾应许：常晴无雨，常乐无痛苦，常安无虞。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "神却曾应许：生活有力，行路有光亮，作工得息，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "试炼得恩助，危难有赖，无限的体谅，不尽的爱。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
