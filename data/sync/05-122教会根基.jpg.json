  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "教会惟一的根基，是主耶稣基督；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "圣水圣言所造成，是主的新创作；",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "主从上天来求她，为主圣洁新妇；",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "舍身流血求得她，建立万年基础。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "虽从万邦选出来，信徒却成一体。",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "教会救恩的凭证，一主、一信、一洗；",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "同尊惟一的圣名，同餐惟一天粮，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "同 怀惟一的 希望，同蒙恩爱久长。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "她在争战喧声里,艰难劳苦之中，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "她却深信有平安，安心静待成功；",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "直至欲穿的望眼，看见光荣远象，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "到 时凯旋的 教会，得 享永憩无 疆。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "她虽在地却联合真神三位一体，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "已享安息圣众的神秘甜蜜团契；，",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "恳求救主使我们，能象快乐圣众，，",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_v4",
        "text": "同 样温柔又谦虚，永在主前供奉。",
        "label": "第4段：第4谱行"
      }
    ],
