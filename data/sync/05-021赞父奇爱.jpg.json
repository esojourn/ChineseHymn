  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "父啊，久在创世之前，你选我们爱难述；，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "这爱深厚、激励、甘甜吸引我们归耶稣。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "还用恩典，还用恩典，保守我们永稳固。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "保守我们永稳固。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "虽然宇宙逐渐改变，但是我神永坚定；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "他的爱心同他恩言时刻在前常引领。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "奇恩无边，奇恩无边，我们应当赞他名！",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "我们应当赞他名！",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "神的怜是我诗歌，我口颂扬心感激；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "十架代刑，慈爱莫测，深得我心满我意。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "救恩白舍，救恩白舍，连他爱子都不惜！",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "愛3.连他層爱子都不層惜！個",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "慈爱父神！我们现在同心赞美爱无量；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "直到永世，万载、亿载，我们仍是要颂扬！",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "但愿敬拜，但愿敬拜，永远归神和羔羊！",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_v4",
        "text": "永远归神和羔羊！（阿们）",
        "label": "第4段：第4谱行"
      }
    ],
