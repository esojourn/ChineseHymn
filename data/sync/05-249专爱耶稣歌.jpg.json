    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "惜哉，忧哉，罪人违逆，何等愚因我罪辜！",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "我曾对主狂妄言日：“专爱已，不爱耶稣；",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "专爱己，不爱耶稣；专爱己，不爱耶稣。”",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "我曾对主狂妄言日：“专爱已，不爱耶稣。”",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "何等恩惠，罪人见主，悬苦架救我罪奴；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "心微动矣，低声言日：“虽爱已，也爱耶稣；",
