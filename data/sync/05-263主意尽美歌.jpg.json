    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "救主子民还在世间，有时难免流泪试炼，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "虽然此刻不知何益，后来到家必要知悉。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "一生一世只管靠主，不用惧怕，主无错误。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "虽有多事还不甚明，主意尽美可以安心。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "天下万事互相效力，使主子民随时获益，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "我们应当一无挂虑，常常喜乐靠主应许。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "一生一世只管靠主，不用惧怕，主无错误。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "虽有多事还不甚明，主意尽美可以安心。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "今所遇见万般事情，多是奥秘不易知清，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "惟当深信主恩无尽，主既安排总可安心。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "一生一世只管靠主，不用惧怕，主无错误。",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "虽有多事还不甚明，主意尽美可以安心。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "或有善事尚未成就，不可灰心，不可退后，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "仰望耶稣忍耐顺从，主既创始亦必成终。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "一生一世只管靠主，不用惧怕，主无错误。",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "虽有多事还不甚明，主意尽美可以安心。",
        "label": "第4段：第4谱行"
      },
      {
        "region": "s1_v5",
        "text": "凡事祈祷，凡事谢恩，不可疑惑，不可怨恨，",
        "label": "第5段：第1谱行"
      },
      {
