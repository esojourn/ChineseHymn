    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "这是天父世界，孩童侧耳要听，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "宇宙唱歌四 围响应,星辰作乐同 声。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "树木花草，苍天碧海，述说天父全能。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s1_v2",
        "text": "这是天父世界，小鸟长翅飞鸣，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "清晨明亮，好 花美丽，证明天理精 深。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "风吹之草，将 他表现，天父充满世间。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s1_v3",
        "text": "这是天父世界，求主叫我不忘，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "罪恶虽然好 像得胜，天父却仍掌 管。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "上帝是王，天地同唱，歌声充满万方。",
        "label": "第3段：第3谱行"
      }
    ],
