    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "主耶稣啊！我赞美你；你的公义好象高山，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "你的信实达到穹苍， 你的判语如同深渊。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "主耶稣！我赞美你，因你比万有更美；",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "有你就有了一切，在地如同在天。（阿们）",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "主耶稣啊！我感谢你；．你的慈爱上及诸天，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "你的恩典存到永远，你的带领满有平安。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "主耶稣！我赞美你，因你比万有更美；",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "有你就有了一切，在地如同在天。（阿们）",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "主耶稣啊！我跟随你；你的圣名何等芬芳，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "你的美酒何其馨香， 你的活水我心渴望。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "主耶稣！我赞美你，因你比万有更美；",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "有你就有了一切，在地如同在天。（阿们）",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "我虽瓦器，主不丢弃；宝血洗净，主灵充盈，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "作光作盐引人主前，哈利路亚！荣归父神。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "主耶稣！我赞美你，因你比万有更美；",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "有你就有了一切，在地如同在天。（阿们）",
        "label": "第4段：第4谱行"
      }
