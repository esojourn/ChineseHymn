    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "众扬声赞美主，哈利路亚！在伯利恒天使天军齐声唱；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "因救主降临，哈利路亚！众天使同声赞扬；",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "听天上他们美妙歌颂声，此佳音传于普天下众人。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "众扬声赞美主，因救主降临，哈利路亚！",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "众扬声赞美主，因救主降临为王。",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s1_v2",
        "text": "众扬声赞美主，哈利路亚！普天下人将听天使歌颂声；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "众岛屿欢唱，哈利路亚！诸山岳同声响应；",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "在地上信徒亦要常传讲，基督是救主以马内利王。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "众扬声赞美主，因救主降临，哈利路亚！",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "众扬声赞美主，因救主降临为王。",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s1_v3",
        "text": "众扬声赞美王哈利路亚！世上众人常闻此佳音传报；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "群天使歌唱，哈利路亚！主荣光满天高照；",
        "label": "第3段：第2谱行"
      },
      {
