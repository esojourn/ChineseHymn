    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "我主耶稣，惟你是配永永远远受赞美；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "因你爱心恩典、善良，远超我们所能想。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s1_v2",
        "text": "我们满心感激不尽，前来称颂你尊名；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "一生一世满被恩惠，到处 述说你宝贵。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s1_v3",
        "text": "我们所拜救主耶稣，满有恩典何宽恕；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "你的爱心和你能力，永无限量永无已。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s1_v4",
        "text": "耶稣，你是首先末后，你要领我到永久；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "因着已往，我赞美你，为着将来，我靠你。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s1_v5",
        "text": "赞他！赞他！赞我恩人，圣徒们哪，当高声！",
        "label": "第5段：第1谱行"
      },
      {
        "region": "s2_v5",
        "text": "赞他！赞他！直到天上，赞美完全，赞久长。阿们）",
        "label": "第5段：第2谱行"
      }
    ],
