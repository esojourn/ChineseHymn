  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "耶稣啊，依然站立，紧闭心门之外，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "依然虚心，仍忍耐，希望跨进门来。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "我众枉作主门徒，枉负救主名号，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "可羞，可羞，可羞极，尽他久立心焦！",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "耶稣啊，依然敲门，手中血迹犹新，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "头上依旧戴荆冠，慈容仍满泪痕。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "人智难量的深爱，如此耐心久待！",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "可恨无边的罪孽，长在门前阻碍！",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "耶稣啊，依然低声殷勤苦劝开门，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "“我曾为你舍生命，你竟如此忍心？”",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "听罢忧惭相交并，我便大开心门；",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "亲爱的主，请进来，与我永远相亲！（阿们）",
        "label": "第3段：第4谱行"
      }
    ],
