    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "我唱耶稣大慈爱，救我身体灵魂，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "我 走 迷路他 寻找，引 我 归回羊 群。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "主恩宽阔如海洋，高大又似诸天，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "万 民万物皆 服从，永 赞主恩无限。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "主的爱越久越深，主的爱越久越深，",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "深似最深海洋，我要时常歌唱，",
        "label": "第1段：第6谱行"
      },
      {
        "region": "s7_chorus",
        "text": "主的爱越久越深。（阿们）",
        "label": "第1段：第7谱行"
      },
      {
        "region": "s1_v2",
        "text": "昔年在犹太国里，救主道成肉身，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "到 处 殷勤传 福音，使人 蒙召得 恩。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "伤 心者主曾 安慰，瞎 眼者主医 明。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "乐哉！自古到如今，主还拯救罪人。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "主的爱越久越深，主的爱越久越深，",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "深似最深海洋，我要时常歌唱，",
        "label": "第2段：第6谱行"
      },
      {
        "region": "s7_chorus",
        "text": "主的爱越久越深。（阿们）",
        "label": "第2段：第7谱行"
      },
      {
        "region": "s1_v3",
        "text": "大哉！主恩最奇妙！为我甘心受死，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "担当我罪无怨言，忍受凌辱苦刑。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "愿众天军与圣徒，同口颂主德行，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "万物齐发欢乐声，赞美救主圣名。",
