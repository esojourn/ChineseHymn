  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "奋起，奋起，为耶稣！十架忠勇精兵！",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "高举尊严的大旗，莫损我主威名。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "一阵一阵的战胜，主自统率全军；",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "直到敌人都消灭，基督确实为·君。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "奋起，奋起，为耶稣！号角传来军令；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "今天是主光荣日，快向前方猛进。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "大家同归主魔下，抵抗无数敌人；",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "临险之时见胆量，勇气百倍加增。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "奋起，奋起，为耶稣！但凭救主大能；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "血气之勇难持久，不敢依赖自身。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "披上福音的盔甲，警醒，祈祷，虔诚；",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "面临责任或艰险，有备自操必胜。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "奋起，奋起，为耶稣！交战不会久长；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "今日战场声喧嚣，明日凯歌悠扬。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "立功之人蒙赏戴生命冠冕辉煌；",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_v4",
        "text": "追随荣耀的君王，统治悠久无疆。",
        "label": "第4段：第4谱行"
      }
    ],
