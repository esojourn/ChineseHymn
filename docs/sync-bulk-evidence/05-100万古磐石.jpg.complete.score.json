  "performanceOrder": [
    {
      "region": "s1_v1",
      "text": "万古磐石为我开，容我藏身在主怀；",
      "label": "第1段：第1谱行"
    },
    {
      "region": "s2_v1",
      "text": "愿因主流水和血，洗我一生诸罪孽，",
      "label": "第1段：第2谱行"
    },
    {
      "region": "s3_v1",
      "text": "使我免干主怒责，使我污浊成清洁。．",
      "label": "第1段：第3谱行"
    },
    {
      "region": "s1_v2",
      "text": "纵使辛劳直到死，纵使流泪永不止，",
      "label": "第2段：第1谱行"
    },
    {
      "region": "s2_v2",
      "text": "依旧不能赎罪过,惟有耶稣能救我；",
      "label": "第2段：第2谱行"
    },
    {
      "region": "s3_v2",
      "text": "两手空空无代价，只靠救主十字架。",
      "label": "第2段：第3谱行"
    },
    {
      "region": "s1_v3",
      "text": "当我呼吸余一息，当我临终目垂闭，",
      "label": "第3段：第1谱行"
    },
    {
      "region": "s2_v3",
      "text": "当我诞登新世界,到主座前恭敬拜；",
      "label": "第3段：第2谱行"
    },
    {
      "region": "s3_v3",
      "text": "万古磐石为我开，容我藏身在主怀。",
      "label": "第3段：第3谱行"
    }
  ],
