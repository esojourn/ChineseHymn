    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "1同蒙天召姊妹兄弟，主内彼此团契；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "以 灵相通，以 爱相系，大 家连为一体。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "灵风吹煦，灵雨，滋润，气",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "候温和最宜人，同沐主恩无尽（阿们）",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "一主、一信、一洗、一神，莫非灵界中人；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "同 气连枝，心 心相印，胜于骨肉之亲。，",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "灵风吹煦，灵雨，滋润，气",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "候温和最宜人，同沐主恩无尽（阿们）",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "情谊深厚，和睦同居，共表友爱精神；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "忧患相关，互 相体恤，喜乐由心入心。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "灵风吹煦，灵雨，滋润，气",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "候温和最宜人，同沐主恩无尽（阿们）",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "经筵圣会时聚主前，深蒙圣父恩春；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "饱餐灵食，满我心愿，滋味何能言宣！",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "灵风吹煦，灵雨，滋润，气",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "候温和最宜人，同沐主恩无尽（阿们）",
        "label": "第4段：第4谱行"
      },
      {
        "region": "s1_v5",
        "text": "灵内相聚，永不分散，无分时间、空间；",
        "label": "第5段：第1谱行"
      },
      {
        "region": "s2_v5",
        "text": "福 乐美满，在 地如天，欣 感主恩无边。",
        "label": "第5段：第2谱行"
      },
