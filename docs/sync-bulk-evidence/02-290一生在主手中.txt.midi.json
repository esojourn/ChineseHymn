  "performanceOrder": [
    {
      "region": "r1",
      "text": "一生在神手中，愿你支配使用； 愿将我命，我灵，我友，全交托你护佑。",
      "label": "第1段"
    },
    {
      "region": "r2",
      "text": "一生在神手中，不论遇何环境， 遇福遇祸，黑暗光明，全顺服你带领。",
      "label": "第2段"
    },
    {
      "region": "r3",
      "text": "一生在神手中，被钉十架恩主！ 为我罪过双手刺透，如今带领保守。",
      "label": "第3段"
    },
    {
      "region": "r4",
      "text": "一生在神手中，永远信靠顺服； 将来被召到主面前，永享安息美福。",
      "label": "第4段"
    }
  ],
