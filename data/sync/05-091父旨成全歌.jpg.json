    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "在那寂静漆黑的晚间，主耶稣钉十架以前，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "他屈膝在客西马尼园，祈祷：“愿父美意成全。”",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "父神美意我愿全遵行，在神面前等",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "候安静；父神美意，我愿全遵行，",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "任神面前等候安静。（阿们）",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s1_v2",
        "text": "耶稣疲倦伤痛的泪眼，不看环境只望着天，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "十架苦杯虽然极难饮，然而他说：“父意成全。”",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "父神美意我愿全遵行，在神面前等",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "候安静；父神美意，我愿全遵行，",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "任神面前等候安静。（阿们）",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s1_v3",
        "text": "主阿！你专以父事为念，虽至死亡也不改变；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "我也愿意实行主圣言，顺服父旨忍受试炼。，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "父神美意我愿全遵行，在神面前等",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "候安静；父神美意，我愿全遵行，",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "任神面前等候安静。（阿们）",
        "label": "第3段：第5谱行"
      },
      {
        "region": "s1_v4",
        "text": "不论前程苦痛或甘甜，总愿意你替我拣选，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "不随自己厌恶或喜欢，总说：“愿父美意成全。”",
