  "independentTimelines": {
    "05-272虹霓雨点歌.mp3": {
      "definitions": [
        {
          "region": "s1_v1",
          "text": "虽有暴风乌云天空弥漫，生活中常有痛苦重担；",
          "label": "第1段：第1谱行"
        },
        {
          "region": "s2_v1",
          "text": "基督为我领港引导在前，他差遣虹霓和雨点。他差遣",
          "label": "第1段：第2谱行"
        },
        {
          "region": "s3_chorus",
          "text": "虹霓，美丽的虹霓，他差遣虹霓和雨点。他差遣日光，",
          "label": "第1段：第3谱行"
        },
        {
          "region": "s4_chorus",
          "text": "照亮全地面，他差遣虹霓和雨点。（阿们）",
          "label": "第1段：第4谱行"
        },
        {
          "region": "s1_v2",
          "text": "朵朵白云如银淡雅素美，灿烂的日光时明时晦；",
          "label": "第2段：第1谱行"
        },
        {
          "region": "s2_v2",
          "text": "不要忧愁不要灰心抱怨，他差遣虹霓和雨点。",
          "label": "第2段：第2谱行"
        },
        {
          "region": "s3_chorus",
          "text": "虹霓，美丽的虹霓，他差遣虹霓和雨点。他差遣日光，",
          "label": "第2段：第3谱行"
        },
        {
          "region": "s4_chorus",
          "text": "照亮全地面，他差遣虹霓和雨点。（阿们）",
          "label": "第2段：第4谱行"
        },
        {
          "region": "s1_v3",
          "text": "曙光破晓美丽青天出现，基督我救主来到面前；",
          "label": "第3段：第1谱行"
        },
        {
          "region": "s2_v3",
          "text": "那时与主同在欢乐无限，他差遣虹霓和雨点。",
          "label": "第3段：第2谱行"
        },
        {
          "region": "s3_chorus",
          "text": "虹霓，美丽的虹霓，他差遣虹霓和雨点。他差遣日光，",
          "label": "第3段：第3谱行"
        },
        {
          "region": "s4_chorus",
          "text": "照亮全地面，他差遣虹霓和雨点。（阿们）",
          "label": "第3段：第4谱行"
        }
      ],
