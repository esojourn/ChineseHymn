    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "我闻耶稣有声说道：“就我享受平安；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "劳苦之人都当休息，低头靠我怀‘间。”",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "我本劳苦，疲倦，忧愁，我既前来就主；",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "在 主爱中快 乐欢欣，觅 得安身之处。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "我闻耶稣有声说道：“我有活水灵泉；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "可让渴者自由取饮，生活力量加添。”",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "我闻主言既来就主，畅饮澄清活水；",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "苦 渴顿消,灵 魂重苏,怡 然活在主怀。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "我闻耶稣有声说道：“我乃暗中明光；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "向我仰望，我是太阳，终日照耀辉煌。”",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "我闻主言，向主仰望，得见红日明星；",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "我 必藉主生 命光明，行 完一世路程。",
        "label": "第3段：第4谱行"
      }
    ],
