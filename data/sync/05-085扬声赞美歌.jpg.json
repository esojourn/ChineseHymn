    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "众扬声赞美主，哈利路亚！在伯利恒天使天军齐声唱；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "因救主降临，哈利路亚！众天使同声赞扬；",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "听天上他们美妙歌颂声，此佳音传于普天下众人。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "众扬声赞美主，因救主降临，哈利路亚！",
