    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "有福的确据，耶稣属我，何等的荣耀向我显明，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "被救主赎回，为神后嗣，藉宝血洗罪，圣灵重生。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "这是我信息，或讲或唱，赞美我救主，心里欢畅。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "常讲主慈爱，并颂主恩，赞美我救主，昼夜不分。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "完全顺服主，我灵欢喜，天堂的荣耀显于我心，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "仿佛有天使由天降临，报明主慈爱，并主怜悯。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "这是我信息，或讲或唱，赞美我救主，心里欢畅。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "常讲主慈爱，并颂主恩，赞美我救主，昼夜不分。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "完全献与主，万事安宁，荣耀的圣灵充满我心，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "时刻仰望主，醒等候，不住地祈祷，到主再临。",
