    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "耶稣，我心所有平安，除主以外，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "无人能给；休息之乐，无扰之安，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "蒙爱的人才能获得。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s1_v2",
        "text": "疲倦的灵，蒙主施恩，患难化成",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "甜蜜安宁；在主恩臂蔽荫之间，",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "我灵不怕风浪敌人。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s1_v3",
        "text": "寂寞旷野，心无畏怯，汪洋大海，“",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "稳渡无惊；前程方向，我不担心，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "因我终身与主同行。",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s1_v4",
        "text": "基督是我终身向导，多愁夜里",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "保惠之师，孤独期间真挚良友，",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "是我救主、光明、策士。",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s1_v5",
        "text": "力量光阴，愿献于主；内心行动，",
        "label": "第5段：第1谱行"
      },
      {
        "region": "s2_v5",
        "text": "愿依圣意；愿在平安、赞美中间，",
        "label": "第5段：第2谱行"
      },
      {
        "region": "s3_v5",
        "text": "静待我主永恒时期。（阿们）",
        "label": "第5段：第3谱行"
      }
    ],
