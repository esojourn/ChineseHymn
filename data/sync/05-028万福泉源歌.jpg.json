  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "全能上帝，万福泉源，恳求垂听我赞美。",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "上帝 恩典似水 长流,我们 高声颂恩 惠。 ",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "愿主 教我唱诗 和谐,犹如 天使颂主前。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "上帝 恩典实无穷尽，主的慈爱不变迁。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "我的 一生 有主 引导,时时 刻刻蒙主 恩。 ",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "只求上帝永不离我，直到进入天家门。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "有时 如羊迷失正路，主如 牧者来找寻。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "救我 脱离一切危险，为我流血舍性命。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "救主鸿恩实在 高深，万分 之中难报一。",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "慈悲 救主恳求 助我，侍奉上帝尽我力。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "我深知道我心软弱，容易离开我上帝。",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "今将身心献为活祭，恳求收纳莫丢弃。",
        "label": "第3段：第4谱行"
      }
    ],
