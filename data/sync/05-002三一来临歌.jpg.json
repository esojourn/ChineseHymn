    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "恳求圣父来临，助我赞美主",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "名，敬献心声！惟主无上尊荣，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "惟主完全得胜，求主统治我们，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "万古之神！",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "悬求圣子来临，彰显威严大",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "能，垂听呼声！施恩与众子民，",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "使主圣道振兴，建立善义公平，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "救主良廣朋財",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "恳求圣灵来临，显出神圣见",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "证，感化众人！惟主全能至尊，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "恳求统治众心，永不离开我们，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "大能圣層灵！",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "圣父圣子、圣灵，当受万民颂",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "称，世世无尽！但愿我众齐来，",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "欢然瞻仰圣明，虔诚亲爱崇敬，",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_v4",
        "text": "直到永恒。（阿们）",
        "label": "第4段：第4谱行"
      }
    ],
