    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "我听复活救主召唤：“跟随我！跟随我！跟随我！”",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "终日呼唤口渴舌干：“跟随我！跟随我！跟随我！”",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "“为救你，我撇弃一切，为救你，我流出宝血，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "尝尽苦杯，经过苦穴，跟随我！跟随我！跟随我！”“",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "“你虽犯罪，我必赦免！跟随我！跟随我！跟随我！",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "去旧换新，使你完全，跟随我！跟随我！跟随我！”",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "“为救你，我撇弃一切，为救你，我流出宝血，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "尝尽苦杯，经过苦穴，跟随我！跟随我！跟随我！”“",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "“放下你的一切忧虑，跟随我！跟随我！跟随我！",
        "label": "第3段：第1谱行"
      },
      {
