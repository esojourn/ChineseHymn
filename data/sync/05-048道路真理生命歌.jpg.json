    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "主是道路，从主而行，方能出死入生；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "无论何人寻求天父，当从主路而行。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s1_v2",
        "text": "主是真理，惟主圣言能赐智慧聪明；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "惟主多方教导我心,使我心地洁清。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s1_v3",
        "text": "主是生命，已裂之坟证明胜死权能；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "人能诚心信托我主，定免地狱忧惊。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s1_v4",
        "text": "主是道路、真理、生命，求使认识路程；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "坚守真理，获得生命，永远快乐安宁。（阿们）",
        "label": "第4段：第2谱行"
      }
    ],
