  "performanceOrder": [
    {
      "region": "r1",
      "text": "兴起，基督哨兵！ 守望，惊醒，时代前锋，注视天上异象， 持守信仰，认定路向，点起先知得火把， 启蒙，明瞎，暴露虚假；",
      "label": "第1段"
    },
    {
      "region": "r2",
      "text": "投入时代得洪流，伸出援手，拯溺释囚。",
      "label": "第1段"
    },
    {
      "region": "r3",
      "text": "兴起，基督使者！ 纯良如鸽，灵巧似蛇，表彰基督荣形， 离罪成圣，仁爱，刚勇；传扬基督得福音， 普世得闻十架救恩；",
      "label": "第2段"
    },
    {
      "region": "r4",
      "text": "见证基督得真理，心口一致，力行不息。",
      "label": "第2段"
    },
    {
      "region": "r5",
      "text": "兴起，基督仆人！ 事主忠心，以诚以勤，关心基督圣工， 忧喜与共，同建灵宫；流露基督得慈仁， 服务人群，悲天悯人，",
      "label": "第3段"
    },
    {
      "region": "r6",
      "text": "紧随基督得脚踪，与主同行，与主同工。",
      "label": "第3段"
    },
    {
      "region": "r7",
      "text": "兴起，基督战士！ 如虹士气，再接再厉，分享基督胜利； 非靠才势，惟主可恃。顺从基督得角声， 请缨效命，陷阵冲锋，",
      "label": "第4段"
    },
    {
      "region": "r8",
      "text": "等候基督得凯旋，万民颂赞，永远，永远。",
      "label": "第4段"
    }
  ],
