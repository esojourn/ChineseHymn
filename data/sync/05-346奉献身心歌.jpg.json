    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "我愿献身心，为基督而活，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "在一切事上，讨我主喜悦，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "欢欣顺服主，凭主旨导引，，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "甘愿背十架，一路随主行。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "哦，主耶稣我救主，我心奉献给你，",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "因你在十字架上，为赎我罪钉死；",
        "label": "第1段：第6谱行"
      },
      {
        "region": "s7_chorus",
        "text": "我要你作我救主，来住在我心里，",
        "label": "第1段：第7谱行"
      },
      {
        "region": "s8_chorus",
        "text": "我一生一世到永远,要忠心服事你。（阿们）",
        "label": "第1段：第8谱行"
      },
      {
        "region": "s1_v2",
        "text": "慈悲主耶稣，受死作中保，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "使我免罪孽，复与神和好，",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "感激主大爱，愿听主呼召，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "奉献我一切，来随主引导。",
        "label": "第2段：第4谱行"
      },
