    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "求赐我圣经，如晨星放光芒，孤独漂泊者 藉此得欢畅；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "耶稣已经来寻找迷路之羊，再没有云雾能遮盖此光。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "求赐我圣经，就是主的恩光，教训和应许，仁爱和典章；",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "因为我知道主必要引导我，走平安道路，前程永辉煌。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "求赐我圣经，在我危急之时，因罪忧愁使我心悲伤；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "耶稣的宝训，我当终身仰望，救主必再来，我们要发光。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "求赐我圣经，就是主的恩光，教训和应许，仁爱和典章；",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "因为我知道主必要引导我，走平安道路，前程永辉煌。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "求赐我圣经，就是永生之灯，虽面临坟墓，我也不惊慌，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "经死亡冷波，主必使我复活，上升到天家，得享大荣光。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "求赐我圣经，就是主的恩光，教训和应许，仁爱和典章；",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "因为我知道主必要引导我，走平安道路，前程永辉煌。",
        "label": "第3段：第4谱行"
      }
