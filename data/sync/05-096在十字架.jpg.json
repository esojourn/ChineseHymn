    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "可叹我主圣体血流,为我受死哀痛，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "情愿舍命赎我尤，我乃卑微无用。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "在我主十字架，我已见主恩光，罪重担从我心皆脱",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "落。 在圣 架我因信,眼明亮,心平康,到如",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "今我终日常欢乐。（阿们）",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s1_v2",
        "text": "诚哉！救主因我罪深，被钉苦架舍身，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "莫大恩典，莫大怜，无穷无尽爱心。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "在我主十字架，我已见主恩光，罪重担从我心皆脱",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "落。 在圣 架我因信,眼明亮,心平康,到如",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "今我终日常欢乐。（阿们）",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s1_v3",
        "text": "真神爱子受人凌辱，身悬在十字架，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "太· 阳隐避似不忍睹，地震如同惊怕。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "在我主十字架，我已见主恩光，罪重担从我心皆脱",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "落。 在圣 架我因信,眼明亮,心平康,到如",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "今我终日常欢乐。（阿们）",
        "label": "第3段：第5谱行"
      },
      {
        "region": "s1_v4",
        "text": "当主宝架显现于前，使我惭愧羞耻，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "深感主恩大爱无限.双目流泪不止。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "在我主十字架，我已见主恩光，罪重担从我心皆脱",
