  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "冬天已往，雨水已止，百花开放，百鸟鸣啼，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "何必等待，何必迟疑，“我的佳偶，与我同去。”",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "耶稣我主，我爱所归，我身我灵永属于你。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "幽谷之中，思你心切；与你同去，今又春回！",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "求你容我得见你面，求你容我闻你低语，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "你声柔和，你貌秀美，“我的鸽子，与我同去。”",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "耶稣我主，我爱所归，我身我灵永属于你。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "幽谷之中，思你心切；与你同去，今又春回！",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "我的良人，我跟从你，离开陡岩隐密之地，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "百鸟声中，百花丛里，随你脚踪，与你同去。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "耶稣我主，我爱所归，我身我灵永属于你。",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "幽谷之中，思你心切；与你同去，今又春回！",
        "label": "第3段：第4谱行"
      }
    ],
