  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "我必全心全意爱他，依靠他丰富恩惠；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "我本来象迷失亡羊，流离圈外游荡；",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "善牧耶稣来寻找我，领我归回他身旁。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "耶稣，耶稣，比一切更宝贵！耶稣，耶稣，",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "乃我全心所归！无论主领我往何处，",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "或福或祸永随；等到我路程走完毕，在天与我主相会。（阿们）",
        "label": "第1段：第6谱行"
      },
      {
        "region": "s1_v2",
        "text": "各各他山主流宝血，死在十架为我罪，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "由死复活得胜魔鬼，以后升上高天，",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "不久乘云迎接圣徒，天家同住乐无边。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "耶稣，耶稣，比一切更宝贵！耶稣，耶稣，",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "乃我全心所归！无论主领我往何处，",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "或福或祸永随；等到我路程走完毕，在天与我主相会。（阿们）",
        "label": "第2段：第6谱行"
      },
      {
        "region": "s1_v3",
        "text": "耶稣是我生命粮食，又是明亮的晨星；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "耶稣是我永远产业，是我平安洪福；",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "我有耶稣还怕什么？有他我满心知足。",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "耶稣，耶稣，比一切更宝贵！耶稣，耶稣，",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "乃我全心所归！无论主领我往何处，",
