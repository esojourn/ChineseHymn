  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "救主复活之良辰！普世快同传述；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "喜乐欢欣逾越节，上帝的逾越节；",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "主在得胜歌声中，已经超拔我们，·",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "离死进入了永生，离地升上天庭。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "恳求洗涤我心胸，除尽罪孽迷蒙，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "愿能清楚地瞻仰复活光里圣容；",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "愿能倾听主声音，清爽、温柔、镇静，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "低言“愿你们平安”，使我加倍欢腾。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "但愿诸天同喜乐，但愿大地高歌，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "但愿世界与万有，欢声四下应和；",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "有形无形之万物，齐发音乐之声，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "因主基督已复生，我众欢乐永恒。",
        "label": "第3段：第4谱行"
      }
    ],
