    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "为着这饼和这杯，为着神子曾降卑，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "为着神恩如雨沛，主，我们感谢你。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s1_v2",
        "text": "依然是酒依然饼，藉此信心却看明，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "爱心神圣的小影，主，我们感谢你。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s1_v3",
        "text": "为着你曾召我们，举目仰望你救恩，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "藉着信心近你身，主，我们感谢你。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s1_v4",
        "text": "为着你曾发命令，要我纪念你所行，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "何等温柔何等贫，主，我们感谢你。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s1_v5",
        "text": "为着你曾用慈爱，引我想家在天外，",
        "label": "第5段：第1谱行"
      },
      {
        "region": "s2_v5",
        "text": "“行此直等到我来”，主，我们感谢你。",
        "label": "第5段：第2谱行"
      },
      {
        "region": "s1_v6",
        "text": "直到他来我壁饼，表明他作我生命，",
        "label": "第6段：第1谱行"
      },
      {
        "region": "s2_v6",
        "text": "为我睡了为我醒，主，我们感谢你。",
        "label": "第6段：第2谱行"
      },
      {
        "region": "s1_v7",
        "text": "直到他来我饮杯，表明他赐福全备，",
        "label": "第7段：第1谱行"
      },
      {
        "region": "s2_v7",
        "text": "使我站在新地位，主，我们感谢你。",
        "label": "第7段：第2谱行"
      }
    ],
