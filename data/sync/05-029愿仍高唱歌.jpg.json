    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "昔日所唱诗歌今日我愿仍高唱，荣耀归神，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "哈利路亚！颂主奇妙救恩慈爱浩大真无量，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "荣耀归神，哈利路亚！我众圣徒速兴起，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "环绕宝座齐歌唱，因主圣手常引导，前途",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "愈走愈明亮，踊跃欢欣向前行，父家隐隐已在",
