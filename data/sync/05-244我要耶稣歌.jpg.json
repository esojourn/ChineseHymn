    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "我要耶稣，我真需要耶稣，在忧愁时，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "别无朋友象主。 我今欢乐，因得所需耶稣；",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "虽有人自己负重担，惟我要 耶稣。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我要耶稣，我要耶稣，每日我需要耶稣；",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "光明时日我要他，黑云满布我要他，",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "在我每日生命中，我要耶稣。（阿们）",
        "label": "第1段：第6谱行"
      },
      {
