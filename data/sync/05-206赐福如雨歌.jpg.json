    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "主必赐福如雨大降，是主应许大慈爱；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "既得福雨神清气壮，救主在上赐下来。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "赐福如雨下，福雨我们正需要，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "真神慈爱逐滴降下，大雨是从我祷告。（阿们）",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "主必赐福如雨大降，教会复兴有见证；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "经过山岭溪谷诸地，甘霖沛雨我闻声。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "赐福如雨下，福雨我们正需要，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "真神慈爱逐滴降下，大雨是从我祷告。（阿们）",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "主必赐福如雨大降，求主赏我更丰盛；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "恳赐我们心灵舒畅，全来尊敬主命令。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "赐福如雨下，福雨我们正需要，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "真神慈爱逐滴降下，大雨是从我祷告。（阿们）",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "主必赐福如雨大降，盼望此刻自天倾；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "如今同认父在天上，专心求告耶稣名。",
