    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "普天之下，万族万民，俱当向主欢",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "呼颂扬，乐意事奉，虔诚称颂，来",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "到主前高声歌唱。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s1_v2",
        "text": "当知主是独一真神，不藉人力创",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "造万人，赐人身心，赐人粮食，招",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "收万众进他羊群。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s1_v3",
        "text": "大家踊跃来到主门，欢欣快乐进",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "主院庭，同心同意感谢真神，高",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "歌颂扬，赞美主名。",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s1_v4",
        "text": "我主我神本是善良，我主慈爱永",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "远长存，我主信实亘古不变，我",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "主恩德万世永恒。（阿们）",
        "label": "第4段：第3谱行"
      }
    ],
