  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "快来拥戴为王，圣羔在宝座上，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "听啊！好乐传遍诸天，和声压倒群响；·",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "醒啊!我心同唱，颂他救恩浩荡，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "欢呼为你受死之主，千秋万岁无疆。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "快来拥戴为王，圣洁至尊神子，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "跟他的人快乐拥戴，因他亦是人子；",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "尘世千万忧伤，一切经他亲尝，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "因他决心担负诸累，群生得享安康。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "快来拥戴为王，独-一生命之王，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "万邦民众都蒙救渡，因他消灭死亡；",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "快来歌颂欢欣，谢他特殊宏恩，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "因他一死战胜万死，永生普及群生。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "快来拥戴为王，永建和平之王，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "普天之下战争止息，干戈化为颂扬；",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "主治万国万方，主权地久天久，",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_v4",
        "text": "宝血所滋，生命花放，蔚成异彩天香。",
        "label": "第4段：第4谱行"
      }
    ],
