    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "感谢至高真神，赞美主大慈爱，．",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "万君之君独尊，万古千秋主宰。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "主恩主权永远常在，主恩主权永远常在，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "颂赞感谢，直到万代。（阿们）",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "太初创造天地，高悬日月众星，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "昼夜光照普世， 年、月、日、时分 清。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "主恩主权永远常在，主恩主权永远常在，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "颂赞感谢，直到万代。（阿们）",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "垂怜万方百姓，无法自赎罪忿，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "差遣爱子舍命，救我得升于天。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "主恩主权永远常在，主恩主权永远常在，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "颂赞感谢，直到万代。（阿们）",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "主特摆设筵席，要喂养我心灵，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "天下九州四海，当传拯救鸿恩。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "主恩主权永远常在，主恩主权永远常在，",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "颂赞感谢，直到万代。（阿们）",
