    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "上帝待我有洪恩，真是我慈爱父",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "亲。体贴我软弱，安慰我伤心，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "昼夜保佑不离我的身。常蒙引领，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "至宝至尊。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "自有永有活上帝，赐我生命奇妙",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "神。忧愁变喜乐，患难得安宁，",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "疑是无路自有光明门。哈利路亚！",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "福乐来临。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "上帝应许有万千，在基督里都成",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "全。祈求就得着，寻找就寻见，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "叩门就开一点不迟延。你若能信，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "意外平安。（阿们）",
        "label": "第3段：第4谱行"
      }
    ],
