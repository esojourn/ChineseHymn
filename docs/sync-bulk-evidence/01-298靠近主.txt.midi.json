  "performanceOrder": [
    {
      "region": "r1",
      "text": "主是我永远的福分， 胜过朋友与生命； 在人生孤单旅程中， 恳求主与我同行。",
      "label": "第1段"
    },
    {
      "region": "r2",
      "text": "靠近主，靠近主， 靠近主，靠近主， 在人生孤单旅程中， 恳求主与我同行。",
      "label": "第1段"
    },
    {
      "region": "r3",
      "text": "我不求世界的欢乐， 也不求世界美名； 我愿受任何的劳苦， 只求主与我同行。",
      "label": "第2段"
    },
    {
      "region": "r4",
      "text": "靠近主，靠近主， 靠近主，靠近主， 我愿受任何的劳苦， 只求主与我同行。",
      "label": "第2段"
    },
    {
      "region": "r5",
      "text": "带领我经黑暗幽谷， 安然渡苦海危程； 当天上永生门大开， 愿与主同进天庭。",
      "label": "第3段"
    },
    {
      "region": "r6",
      "text": "靠近主，靠近主， 靠近主，靠近主， 当天上永生门大开， 愿与主同进天庭。",
