    "performanceOrder": [
      {
        "region": "r1",
        "text": "有时享平安，如江河平又稳， 有时忧伤来似浪滚， 在任何环境，我已蒙主引领， 我心灵得安宁，得安宁。",
        "label": "第1段"
      },
      {
        "region": "r2",
        "text": "我心灵得安宁，我心灵得安宁，得安宁。",
        "label": "第1段"
      },
      {
        "region": "r3",
        "text": "撒旦虽相侵，诸多试炼来临， 但有主美证在我心， 基督早看清我孤独之困境， 甘流血救赎我赐安宁。",
        "label": "第2段"
      },
      {
        "region": "r4",
        "text": "我心灵得安宁，我心灵得安宁，得安宁。",
        "label": "第2段"
      },
      {
        "region": "r5",
        "text": "回看我众罪，全钉在十架上， 每想念时心极欢畅， 主担我重担，何奇妙大恩情， 赞美主！我心灵得安宁。",
        "label": "第3段"
      },
      {
        "region": "r6",
        "text": "我心灵得安宁，我心灵得安宁，得安宁。",
        "label": "第3段"
      },
      {
        "region": "r7",
        "text": "求主快再来，使所信得亲见， 云彩将卷起在主前， 号筒声吹响，主再临掌权柄， 愿主来！我心灵必安宁。",
        "label": "第4段"
      },
      {
        "region": "r8",
        "text": "我心灵得安宁，我心灵得安宁，得安宁。",
        "label": "第4段"
