    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "切莫听从试探，中了魔鬼计，一次战胜敌人，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "下次更容易；努力向前战争，克服势与利；",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "时常仰望耶稣，带领你到底。 敬求救主帮助你，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "安慰勉励、看顾你；主真愿意帮助你，主必领你到底。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "远避不良同伴，决不出恶声；尊敬主的圣名，",
