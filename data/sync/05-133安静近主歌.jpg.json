    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "安静吧!安静吧!静听主声音。",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "安静吧!要敬听,主话是宝训。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "轻步走，轻步走，我主在这里；轻步走，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "轻步走,近主献诚意。（阿们）",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "安静吧!安静吧!这是主圣殿；",
        "label": "第2段：第1谱行"
      },
      {
