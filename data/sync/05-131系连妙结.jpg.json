    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "福哉系连妙结，在主爱中同心；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "教会圣徒心灵团契，在地如在天庭。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s1_v2",
        "text": "信众在父座前，同心虔诚祈祷；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "同一艰难、安乐、关心，同一希望、目标。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s1_v3",
        "text": "大家分当忧患，大家分肩重担；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "大家共洒同情之泪，大家休戚相关。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s1_v4",
        "text": "信众生离死别，不像世人哀痛；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "天上人间藉主同心，离别终必重逢。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s1_v5",
        "text": "脱离忧、劳、苦、罪，我们共享自由；",
        "label": "第5段：第1谱行"
      },
      {
        "region": "s2_v5",
        "text": "完全友爱统治人天，经过万古千秋。",
        "label": "第5段：第2谱行"
      }
    ],
