    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "主在坟墓安眠，耶稣我救主；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "等待复活那天，耶稣我主！",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "主从坟墓里复活！得胜一切仇敌与罪孽！",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "主耶稣复活，得胜黑暗死亡；从此永远与圣徒一",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "同作王；主复活主复活！哈利路亚！主复活！",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s1_v2",
        "text": "兵丁守墓无用，耶稣我救主；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "封石仍旧落空，耶稣我主！",
