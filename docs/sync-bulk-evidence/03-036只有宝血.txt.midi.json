  "performanceOrder": [
    {
      "region": "r1",
      "text": "何能使我脱罪担？ 只有主耶稣之宝血。 何能使我得平安？ 只有主耶稣之宝血。",
      "label": "第1段"
    },
    {
      "region": "r2",
      "text": "副歌：主在十架流血， 洗我罪恶清洁，使我白超乎雪， 全赖主耶稣之宝血。",
      "label": "第1段"
    },
    {
      "region": "r3",
      "text": "何能救赎我罪人？ 只有主耶稣之宝血。 何能使我近真神？ 只有主耶稣之宝血。",
      "label": "第2段"
    },
