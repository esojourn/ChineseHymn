  "independentTimelines": {
    "05-037美哉羔羊歌.mp3": {
      "definitions": [
        {
          "region": "s1_v1",
          "text": "美哉！善哉！羔羊的新歌，荣耀归主！荣耀归主！",
          "label": "第1段：第1谱行"
        },
        {
          "region": "s2_v1",
          "text": "这个福音赐无比快乐，荣耀至高的主！",
          "label": "第1段：第2谱行"
        },
        {
          "region": "s3_v1",
          "text": "降生人间耶稣基督，离去天庭是为救赎，",
          "label": "第1段：第3谱行"
        },
        {
          "region": "s4_v1",
          "text": "如此奇爱举世皆无，世人都可蒙恩泽。",
          "label": "第1段：第4谱行"
        },
        {
          "region": "s5_chorus",
          "text": "大声赞美，口唱心和，荣耀归主！荣耀归主！",
          "label": "第1段：第5谱行"
        },
        {
          "region": "s6_chorus",
          "text": "自古以来无此诗歌，荣耀至高的主！（阿们）",
          "label": "第1段：第6谱行"
        },
        {
          "region": "s1_v2",
          "text": "听哪！歌声由天上飘来，荣耀归主！荣耀归主！",
          "label": "第2段：第1谱行"
        },
        {
          "region": "s2_v2",
          "text": "神就是光神也就是爱，荣耀至高的主！",
          "label": "第2段：第2谱行"
        },
        {
          "region": "s3_v2",
          "text": "世上所有悲伤人们，不必绝望，毋须烦闷，",
          "label": "第2段：第3谱行"
        },
        {
          "region": "s4_v2",
          "text": "抬起头来仰望救恩，耶稣救主都恩待。",
          "label": "第2段：第4谱行"
        },
        {
          "region": "s5_chorus",
          "text": "大声赞美，口唱心和，荣耀归主！荣耀归主！",
          "label": "第2段：第5谱行"
        },
        {
          "region": "s6_chorus",
          "text": "自古以来无此诗歌，荣耀至高的主！（阿们）",
          "label": "第2段：第6谱行"
        },
        {
          "region": "s1_v3",
          "text": "此歌声音应当亮且清，荣耀归主！荣耀归主！",
          "label": "第3段：第1谱行"
        },
        {
          "region": "s2_v3",
          "text": "此歌题目应当常鲜明，荣耀至高的主！",
          "label": "第3段：第2谱行"
        },
        {
          "region": "s3_v3",
          "text": "唱至内心欢喜跳跃，唱至天下布满此调，",
          "label": "第3段：第3谱行"
        },
        {
          "region": "s4_v3",
          "text": "唱至所有蒙爱新造都唱此歌永不停。",
          "label": "第3段：第4谱行"
        },
        {
          "region": "s5_chorus",
          "text": "大声赞美，口唱心和，荣耀归主！荣耀归主！",
          "label": "第3段：第5谱行"
        },
        {
          "region": "s6_chorus",
          "text": "自古以来无此诗歌，荣耀至高的主！（阿们）",
          "label": "第3段：第6谱行"
        }
      ],
