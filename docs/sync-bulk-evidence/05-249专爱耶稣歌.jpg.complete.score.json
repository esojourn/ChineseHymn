    }
  ],
  "performanceOrder": [
    {
      "region": "s1_v1",
      "text": "惜哉，忧哉，罪人违逆，何等愚因我罪辜！",
      "label": "第1段：第1谱行"
    },
    {
      "region": "s2_v1",
      "text": "我曾对主狂妄言日：“专爱已，不爱耶稣；",
      "label": "第1段：第2谱行"
    },
    {
      "region": "s3_v1",
      "text": "专爱己，不爱耶稣；专爱己，不爱耶稣。”",
      "label": "第1段：第3谱行"
    },
    {
      "region": "s4_v1",
      "text": "我曾对主狂妄言日：“专爱已，不爱耶稣。”",
      "label": "第1段：第4谱行"
    },
    {
      "region": "s1_v2",
      "text": "何等恩惠，罪人见主，悬苦架救我罪奴；",
      "label": "第2段：第1谱行"
    },
    {
      "region": "s2_v2",
      "text": "心微动矣，低声言日：“虽爱已，也爱耶稣；",
      "label": "第2段：第2谱行"
    },
    {
      "region": "s3_v2",
      "text": "虽爱己，也爱耶稣；虽爱已，也爱耶稣。”",
      "label": "第2段：第3谱行"
    },
    {
      "region": "s4_v2",
      "text": "心微动矣，低声言日：“虽爱己，也爱耶稣。”",
      "label": "第2段：第4谱行"
    },
    {
      "region": "s1_v3",
      "text": "日兮月兮，主恒爱我，医我心，指引扶助，",
      "label": "第3段：第1谱行"
    },
    {
      "region": "s2_v3",
      "text": "使我谦逊，悔改言日：“少爱己，多爱耶稣；",
      "label": "第3段：第2谱行"
    },
    {
      "region": "s3_v3",
      "text": "少爱己，多爱耶稣；少爱已，多爱耶稣。”",
      "label": "第3段：第3谱行"
    },
    {
      "region": "s4_v3",
      "text": "使我谦逊，悔改言日：“少爱己，多爱耶稣。”",
      "label": "第3段：第4谱行"
    },
    {
      "region": "s1_v4",
      "text": "高越天兮，深逾沧海，主之恩怜爱门徒；",
      "label": "第4段：第1谱行"
    },
    {
      "region": "s2_v4",
      "text": "我今感恩，醒悟言日：“不爱已，专爱耶稣；",
      "label": "第4段：第2谱行"
    },
    {
      "region": "s3_v4",
      "text": "不爱己，专爱耶稣；不爱已，专爱耶稣。”",
      "label": "第4段：第3谱行"
    },
    {
      "region": "s4_v4",
      "text": "我今感恩醒悟言日：“不爱己，专爱耶稣。”",
      "label": "第4段：第4谱行"
    }
  ],
