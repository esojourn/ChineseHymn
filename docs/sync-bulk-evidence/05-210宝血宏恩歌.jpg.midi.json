  "independentTimelines": {
    "05-210宝血宏恩歌.mp3": {
      "definitions": [
        {
          "region": "s1_v1",
          "text": "我听主声欢迎，召我与主相亲，",
          "label": "第1段：第1谱行"
        },
        {
          "region": "s2_v1",
          "text": "在主所流宝血里面，我心能够洗净。",
          "label": "第1段：第2谱行"
        },
        {
          "region": "s3_chorus",
          "text": "主啊，我今来，我今来就主！求用宝血",
          "label": "第1段：第3谱行"
        },
        {
          "region": "s4_chorus",
          "text": "洗净我，洗净一切罪污！（阿们）",
          "label": "第1段：第4谱行"
        },
        {
          "region": "s1_v2",
          "text": "虽我软弱卑污，救主赐我能力，",
          "label": "第2段：第1谱行"
        },
        {
          "region": "s2_v2",
          "text": "将我污点完全洗净，丝毫不留痕迹。",
          "label": "第2段：第2谱行"
        },
        {
          "region": "s3_chorus",
          "text": "主啊，我今来，我今来就主！求用宝血",
          "label": "第2段：第3谱行"
        },
        {
          "region": "s4_chorus",
          "text": "洗净我，洗净一切罪污！（阿们）",
          "label": "第2段：第4谱行"
        },
        {
          "region": "s1_v3",
          "text": "耶稣召我向前，达到完全信望，",
          "label": "第3段：第1谱行"
        },
        {
          "region": "s2_v3",
          "text": "完全仁爱、平安、信靠，在世亦在天堂。",
          "label": "第3段：第2谱行"
        },
        {
          "region": "s3_chorus",
          "text": "主啊，我今来，我今来就主！求用宝血",
          "label": "第3段：第3谱行"
        },
        {
          "region": "s4_chorus",
          "text": "洗净我，洗净一切罪污！（阿们）",
          "label": "第3段：第4谱行"
        },
        {
          "region": "s1_v4",
          "text": "耶稣赏赐宏恩，坚固向善的心，",
          "label": "第4段：第1谱行"
        },
        {
          "region": "s2_v4",
          "text": "从前万恶掌权之处，今蒙恩上加恩。",
          "label": "第4段：第2谱行"
        },
        {
          "region": "s3_chorus",
          "text": "主啊，我今来，我今来就主！求用宝血",
          "label": "第4段：第3谱行"
        },
        {
          "region": "s4_chorus",
          "text": "洗净我，洗净一切罪污！（阿们）",
          "label": "第4段：第4谱行"
        },
        {
          "region": "s1_v5",
          "text": "他向忠实的心，显出充分证明，",
          "label": "第5段：第1谱行"
        },
        {
          "region": "s2_v5",
          "text": "任何应许必能成就，只要信仰虔诚。",
          "label": "第5段：第2谱行"
        },
        {
          "region": "s3_chorus",
          "text": "主啊，我今来，我今来就主！求用宝血",
          "label": "第5段：第3谱行"
        },
        {
          "region": "s4_chorus",
          "text": "洗净我，洗净一切罪污！（阿们）",
          "label": "第5段：第4谱行"
        },
        {
          "region": "s1_v6",
          "text": "美哉，赎罪宝血！美哉，救世宏恩！",
          "label": "第6段：第1谱行"
        },
        {
          "region": "s2_v6",
          "text": "美哉，基督无边妙爱！赏赐公义权能。",
          "label": "第6段：第2谱行"
        },
        {
          "region": "s3_chorus",
          "text": "主啊，我今来，我今来就主！求用宝血",
          "label": "第6段：第3谱行"
        },
        {
          "region": "s4_chorus",
          "text": "洗净我，洗净一切罪污！（阿们）",
          "label": "第6段：第4谱行"
        }
      ],
