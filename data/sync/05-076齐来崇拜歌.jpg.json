    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "齐来，宗主信徒，快乐又欢欣，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "齐来，一齐来，大家上伯利恒；",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "来朝见圣婴，天使王已降生；",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "齐来虔诚同崇拜，齐来虔诚同崇拜，齐",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "来虔诚同崇拜，主基督。（阿们）",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s1_v2",
        "text": "由上主的上主，光明這的光明，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "虚心并不嫌童贞女胎中生；",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "真主的真主，是生成，非造成；",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "齐来虔诚同崇拜，齐来虔诚同崇拜，齐",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "来虔诚同崇拜，主基督。（阿们）",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s1_v3",
        "text": "天使结成乐队，欢然同歌唱，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "光明众天军来高声同赞扬；",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "至高的处所，荣耀归与君王；",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "齐来虔诚同崇拜，齐来虔诚同崇拜，齐",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "来虔诚同崇拜，主基督。（阿们）",
        "label": "第3段：第5谱行"
      },
      {
        "region": "s1_v4",
        "text": "救主生于今晨，我众来欢迎；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "天人诸荣耀，完全归主一身；",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "大哉！父真道，藉肉体来显明；",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_chorus",
