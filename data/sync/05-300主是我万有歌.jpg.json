  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "耶稣是我所有一切，生命、喜乐、荣耀，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "主是我的随时力量，离主我必跌倒；",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "当我愁苦来就耶稣，无人似主如此安抚，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "使我欢欣，解我心忧，主是我友。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "耶稣是我所有一切，急难之时良友，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "恩上加恩，难以计算，因我向主祈求；",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "主赐日光又施甘霖，主使禾田金谷丰盈，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "日光甘霖，大好收成，主是我友。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "耶稣是我所有一切，我要忠诚待主，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "我主于我何等信实，我又何忍负主！",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "步主后尘，我才安心，仰望十架时刻做醒，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "跟随主行，或夜或明，主是我友。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "耶稣是我所有一切，乃我全心爱慕；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "我信靠主，时刻靠主，无论遇福受苦；",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "得此良友慰我一生，与主亲近喜乐日增，",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_v4",
        "text": "永生喜乐，无穷无尽，主是我友。",
        "label": "第4段：第4谱行"
      }
    ],
