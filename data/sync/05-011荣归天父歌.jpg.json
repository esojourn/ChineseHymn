    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "荣耀归于天父！他爱怜普世，为救我们",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "罪人赐下独生子；主也甘心情愿为",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "我们舍命，开天上恩门，使我们得生。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "赞美主！赞美主！全地当尊他名！赞美主！",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "赞美主！万民都当欢欣！藉着圣子耶稣得",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "亲近天父，他已成功救赎，荣耀归天父！",
        "label": "第1段：第6谱行"
      },
      {
        "region": "s1_v2",
        "text": "父神赦罪恩典因主临我们，凡信主的",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "人们靠主得永生；你虽罪恶深重，当",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "信主耶稣，就立时蒙救免，永远得救赎。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "赞美主！赞美主！全地当尊他名！赞美主！",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "赞美主！万民都当欢欣！藉着圣子耶稣得",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "亲近天父，他已成功救赎，荣耀归天父！",
        "label": "第2段：第6谱行"
      },
      {
        "region": "s1_v3",
        "text": "救主已经为我成就了大事，今日得享",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "安乐全靠主赏赐；直等我的眼晴得",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "见主荣形，那时我的福乐更无穷无尽。",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
