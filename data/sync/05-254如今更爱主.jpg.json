    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "我主，我爱主，因感主甚爱我，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "为主，我甘心离有罪之逸乐；",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "惟主，我救主，曾将我罪救赎；",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "昔我曾爱主，我如今更爱主。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "如今我爱主，因为主曾爱我，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "因主救赎我，舍圣身，经万苦；",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "因主哀怜·我，戴荆冠，受欺侮；",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "昔我曾爱主，我如今更爱主。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "无论生与死，我爱主常如此，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "我生有——息，更高歌称扬主，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "临死声虽微，赞美声终不止；",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "昔我曾爱主，我如今更爱主。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "我既登天堂，立在主宝座旁，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "永远敬拜主，赞美主，声悠扬；",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "头戴黄金冕，与众圣常欢聚；",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_v4",
        "text": "昔我曾爱主，我如今更爱主。（阿们）",
        "label": "第4段：第4谱行"
      }
