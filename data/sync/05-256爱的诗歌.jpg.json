  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Documented MIDI melody and independently extracted printed optical rhythm; full symbolic pitch-sequence verification; every row independently matched in each performed verse; harmony comparison retained as diagnostic.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "爱从上帝而来，爱本就是上帝。",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "爱是敬拜真神，爱神也爱兄弟。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "爱是联络全德，．爱是荣神益人，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "爱是荣耀主名，爱是爱人如己。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "爱是恒久忍耐，爱不轻易发怒，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "爱是又有恩慈，爱是从不嫉妒，",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "爱是永不自夸，爱是决不张狂，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "爱不做害羞事，爱不求已益处。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "爱不计算人恶，爱不喜欢不义，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "爱是凡事包容，爱只喜欢真理，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "爱是凡事相信，爱是凡事盼望，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "爱是凡事忍耐，爱是永不止息。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "爱是心存圣洁，爱是胸怀坦白，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "爱是饥渴慕义，爱是相互信赖。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "爱人不可虚假，爱里没有惧怕，",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_v4",
        "text": "爱能胜过罪恶，命令总归是爱。",
        "label": "第4段：第4谱行"
      }
    ],
