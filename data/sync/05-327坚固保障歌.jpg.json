  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "上主是我坚固保障，庄严雄峻，永坚强；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "上主是我安稳慈航，助我乘风冲骇浪。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "」.恶魔盘踞世上，仍谋兴波作浪，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "猖狂狡猾异常，怒气欲吞万象，",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_v1",
        "text": "世间惟他猛无双。",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s1_v2",
        "text": "我若但凭自己力量，自知断难相对抗，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "幸有神人踊跃先登，率领着我往前方。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "如问此人为谁？乃是万军之将，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "又是万有君王，自古万民共仰，",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_v2",
        "text": "耶稣基督名浩荡。",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s1_v3",
        "text": "魔鬼虽然环绕我身，向我尽量施侵凌，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "我不惧怕，因神有旨，真理定能因我胜。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "幽暗之君虽猛，不足令我心惊，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "他怒，我能忍受，日后胜负必分，",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s5_v3",
        "text": "主言必使他败奔。",
        "label": "第3段：第5谱行"
      },
      {
        "region": "s1_v4",
        "text": "此言权力伟大非常，远胜世上众君王，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "圣灵恩典为我所有，因主耶稣在我方。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "亲戚货财可舍，渺小浮生可丧，",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_v4",
        "text": "他虽残杀我身，主道依然兴旺，",
        "label": "第4段：第4谱行"
      },
      {
        "region": "s5_v4",
        "text": "上主国度永久长。（阿们）",
        "label": "第4段：第5谱行"
      }
    ],
