    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "祷告良辰，祷告良辰，召我离开世",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "事操心，引我到父施恩宝座，将我心",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "愿向父说明。每逢痛苦忧愁时节，我",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "网，全亏有此祷告良辰。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "祷告良辰，祷告良辰，何等快乐！何",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "等欢欣！世界多少火热之心，盼望良",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "辰时刻再临！今向救主显示之处，我",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "立，静候再逢祷告良辰。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "祷告良辰，祷告良辰，如有双翼向",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "主飞升，携我衷曲，宛转敷陈，主爱永",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "恒，有求必应。主既召我时常入觐，赖",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "担，静候再逢祷告良辰。（阿们）",
        "label": "第3段：第4谱行"
      }
    ],
