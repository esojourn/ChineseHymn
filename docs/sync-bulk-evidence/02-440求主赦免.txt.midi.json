  "performanceOrder": [
    {
      "region": "r1",
      "text": "若我今天伤害他人心灵，若我今天使他人走错路， 若我今天照己心意偏行，求助赦免！",
      "label": "第1段"
    },
    {
      "region": "r2",
      "text": "若我今天言语不合体统，不关怀别人需要与苦痛， 或许使别人受伤害跌倾，求主赦免！",
      "label": "第2段"
    },
    {
      "region": "r3",
      "text": "若我今天对人冷酷无情，若我只贪图安逸与舒宁， 不愿完成上主交付使命，求主赦免！",
      "label": "第3段"
    },
    {
      "region": "r4",
      "text": "求你赦免我所承认罪咎，求你赦免隐藏未显愆尤， 求你常常引导爱护保守。阿们，阿们！",
      "label": "第4段"
    }
  ],
