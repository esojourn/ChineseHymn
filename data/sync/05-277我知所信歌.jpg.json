    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "不知何以上主恩惠，竟然临到我身；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "不堪如我亦蒙选召，何等奇妙主恩！",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "惟我深知所信的是谁，并且也深信他能保全我，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "也保全我交付他的，都全备，直到那日。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "不知何以因信得救，恩门向我敬开；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "不知何以一信主话，平安便满心怀！",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "惟我深知所信的是谁，并且也深信他能保全我，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "也保全我交付他的，都全备，直到那日。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "不知如何圣灵感动，使我承认罪污；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "由圣经中显 明耶稣，引人信靠救 主。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "惟我深知所信的是谁，并且也深信他能保全我，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "也保全我交付他的，都全备，直到那日。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "不知明日将遇何事，前途或顺或逆；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "但主慈爱永 不更改，主必抚养到 底。",
