    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "我所行的天路虽有时稀旷，将快看见我君王；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "在那赐福之日天空要开朗，将快看见我君王。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "将快看见我君王，将快高声同颂扬；",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "主必赏赐冠冕，信徒有荣光，将快看见我君王。",
        "label": "第1段：第4谱行"
      },
      {
