  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "惟独耶稣是我信息，我所讲论就是耶稣；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "永远高举耶稣基督，我所仰望就是耶稣。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "惟独耶稣，永远耶稣，我心赞美，我口传扬，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "救我医我，使我成圣，荣耀救主，再来之王。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "惟独耶稣是我救主，一切罪为我担负；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "我得称义全靠耶稣，赐我力量日日事主。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "惟独耶稣，永远耶稣，我心赞美，我口传扬，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "救我医我，使我成圣，荣耀救主，再来之王。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "惟独耶稣使我成圣，除我旧人，诸罪洗清；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "真理圣灵充满我心，表彰基督丰富生命。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "惟独耶稣，永远耶稣，我心赞美，我口传扬，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "救我医我，使我成圣，荣耀救主，再来之王。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "惟独耶稣再临君王，等候主来号筒之声；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "接我升天，荣耀盼望，惟独耶稣永生真神。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "惟独耶稣，永远耶稣，我心赞美，我口传扬，",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "救我医我，使我成圣，荣耀救主，再来之王。",
        "label": "第4段：第4谱行"
      }
    ],
