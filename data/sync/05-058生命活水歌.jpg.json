  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "今到救恩泉源欢然汲灵水，解我灵性乾渴，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "心神极快慰。·灵泉自心涌起，永流而不息，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "一直流到永生里。生命活水永远",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "长流，生命活水自长流；生命活水",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "永远长流，生命活水永远自长流。（阿们）",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s1_v2",
        "text": "我心流出泉源愈流而愈涌，主恩藉我溢出，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "表显于无穷。多少困惫心灵因我而苏醒，",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "同得丰盛之生命。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "长流，生命活水自长流；生命活水",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "永远长流，生命活水永远自长流。（阿们）",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s1_v3",
        "text": "时或因有罪欲将灵源杜塞，生命日益枯萎，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "将河流阻隔。 望主赐我清洁、正直的心灵，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "始不至亏欠主荣。",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "长流，生命活水自长流；生命活水",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "永远长流，生命活水永远自长流。（阿们）",
        "label": "第3段：第5谱行"
      },
      {
        "region": "s1_v4",
        "text": "幸我已就恩主尽量饮活泉，腹中流出江河，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "灵恩日彰显。主在我身显大，生命极美满，",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "欣颂主恩乐无边。",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "长流，生命活水自长流；生命活水",
        "label": "第4段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "永远长流，生命活水永远自长流。（阿们）",
        "label": "第4段：第5谱行"
      }
