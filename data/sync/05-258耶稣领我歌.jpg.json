    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "耶稣领我，我真喜欢！蒙主引导，心中平安！",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "无论日夜动静起坐，耶稣圣手时常领我。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "耶稣领我！耶稣领我！耶稣天天亲手领我！",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我愿为主忠实信徒，因蒙主恩亲手领我。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "有时遭遇困苦忧伤，有时大得喜乐安康；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "无论危险，无论稳妥，全靠耶稣亲手领我。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "耶稣领我！耶稣领我！耶稣天天亲手领我！",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我愿为主忠实信徒，因蒙主恩亲手领我。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "我愿紧握恩主圣手，甘心乐意随主行走，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "遇祸遇福两般皆可，因有耶稣亲手领我。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "耶稣领我！耶稣领我！耶稣天天亲手领我！",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我愿为主忠实信徒，因蒙主恩亲手领我。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "到时行完“世路程，靠托主恩完全得胜，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "死亡冷河我不怕过，因有耶稣亲手领我。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_chorus",
