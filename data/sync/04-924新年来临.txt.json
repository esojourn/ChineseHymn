    "performanceOrder": [
      {
        "region": "r1",
        "text": "旧岁已过新年临， 恳切祈求父神； 不论工作或等候， 新年偕主同行；",
        "label": "第1段"
      },
      {
        "region": "r2",
        "text": "新年又是成长年， 充满赞美颂声； 新年更得到明证， 每天与主偕行。",
        "label": "第1段"
      },
      {
        "region": "r3",
        "text": "新年又是恩典年， 充满信心恩惠； 新年又是快乐年， 常见圣言光辉；",
        "label": "第2段"
      },
      {
        "region": "r4",
        "text": "新年又是倚靠年， 紧靠恩主爱怀； 新年成为信托年， 赖主憩息愉快。",
        "label": "第2段"
      },
      {
        "region": "r5",
        "text": "新年又是侍奉年， 见证主爱丰宠； 新年又是训练年， 准备天上圣工；",
        "label": "第3段"
      },
      {
        "region": "r6",
        "text": "旧岁已过新年临， 恳切祈求父神， 不论天上或人间， 新年全都为神。",
        "label": "第3段"
      }
    ],
