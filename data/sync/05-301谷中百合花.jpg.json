  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "我有一位最好朋友，他就是主耶稣，他使饥渴心灵",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "常能得安慰。好比山谷中百合花，洁白、纯净、芳香，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "惟有救主耶稣圣名最完美。痛苦悲伤他怜悯，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "忧患时他安慰，他对我说，他永住在我心内。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "他是山谷中百合花，灿烂明亮晨星，他使饥渴心灵",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "常能得安慰。（阿们）",
        "label": "第1段：第6谱行"
      },
      {
        "region": "s1_v2",
        "text": "他除去我一切烦恼，担当患难忧伤，战胜试探，他作",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "我坚固保障。为他我愿舍去一切，抛弃心中偶像，",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "他用全能臂膀保守我安康。  纵使亲朋离弃我，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "撒但试探引诱，依靠耶稣，心中平安有希望。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "他是山谷中百合花，灿烂明亮晨星，他使饥渴心灵",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "常能得安慰。（阿们）",
        "label": "第2段：第6谱行"
      },
      {
        "region": "s1_v3",
        "text": "他必永远不离开我，时常陪伴身旁，我必信靠耶稣，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "效法主榜样。他是磐石给我力量，使软弱变刚强，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "心灵饥渴，他赐吗哪作灵粮。将来升天见主面，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "同享极大荣光，到达快乐彼岸，生命水流长。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "他是山谷中百合花，灿烂明亮晨星，他使饥渴心灵",
        "label": "第3段：第5谱行"
      },
      {
        "region": "s6_chorus",
        "text": "常能得安慰。（阿们）",
        "label": "第3段：第6谱行"
      }
    ],
