    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "我今来到主的圣殿，赞美歌声上云天；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "心灵诚实，虔诚崇拜，心中何等甘甜！",
        "label": "第1段：第2谱行"
      },
