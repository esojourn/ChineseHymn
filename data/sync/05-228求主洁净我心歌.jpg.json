    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "求主洁净我心，除去一切罪，宝血洗涤污秽，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "罪孽主全救免；耶稣赐我永生，心中充满平安，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "主必保守导引，直到见主那天。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s1_v2",
        "text": "求主洁净我心，使我常想主言，脚前明灯永亮，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "生命吗哪日添；我要醒祈祷，在世作光作盐，",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "主必保守导引，直到见主那天。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s1_v3",
        "text": "求主洁净我心，我心为主圣殿，恳求永居其间，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "保守圣洁完全；终身荣神益人，直到见主那天，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "主必保守导引，直到见主那天。（阿们）",
        "label": "第3段：第3谱行"
      }
    ],
