    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "耶稣向我所存恩爱，舍身流血还我罪债，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "使我得免永远灾害，主恩爱说不尽。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "主爱口舌真说不尽，主爱口舌真说不尽，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "耶稣向我所存恩爱，口舌真说不尽。（阿们）",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "我主受难戴荆棘冕，被人凌辱沫吐满脸，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "使我得蒙救赎恩典，主恩爱说不尽。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "主爱口舌真说不尽，主爱口舌真说不尽，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "耶稣向我所存恩爱，口舌真说不尽。（阿们）",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "我主升天作我中保，天父面前为我祈祷，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "使我罪人与神和好，主恩爱说不尽。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "主爱口舌真说不尽，主爱口舌真说不尽，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "耶稣向我所存恩爱，口舌真说不尽。（阿们）",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "我主时常与我相亲，平安喜乐充满我心，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "有福指望何等光明，主恩爱说不尽。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "主爱口舌真说不尽，主爱口舌真说不尽，",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "耶稣向我所存恩爱，口舌真说不尽。（阿们）",
        "label": "第4段：第4谱行"
      }
