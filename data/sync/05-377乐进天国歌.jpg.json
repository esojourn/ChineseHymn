    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "歌颂耶稣权能仁爱，天家恩门为我开；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "在那光明荣耀天上，主为我预备地方。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "我们都要回天家，今默想如到那日真快乐！",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我们要见救主，我们要高唱得胜歌。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "我今如同旅客行路，有时黑云盖前途；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "等我到那荣华福地，就无愁苦无叹息。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "我们都要回天家，今默想如到那日真快乐！",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我们要见救主，我们要高唱得胜歌。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "我们应当坚心忍耐，醒祈祷等主来；",
        "label": "第3段：第1谱行"
      },
      {
