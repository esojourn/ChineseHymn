    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "主耶稣啊，每想到你，心中便觉甜蜜；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "深愿我能早日见你，与你永在一起。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "主！你是园中的凤仙花，你是谷中的百合花，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "你是沙仑的玫瑰花，我心岂能舍下？",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "世上并无一个声音，能把你恩唱尽；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "人间也无一颗慧心，能道你爱何殷！",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "主！你是园中的凤仙花，你是谷中的百合花，",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "你是沙仑的玫瑰花，我心岂能舍下？",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "最能满足我的心怀，尚非你恩你爱；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "乃你自己和你神采，最能使我畅快。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "主！你是园中的凤仙花，你是谷中的百合花，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "你是沙仑的玫瑰花，我心岂能舍下？",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "你爱多么长阔深高，没有人能知晓；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "蒙爱的人只能说道：哦，你的爱奇妙！”",
        "label": "第4段：第2谱行"
      },
