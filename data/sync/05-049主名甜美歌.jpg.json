  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "美哉！妙哉！神的爱子，作我宝贵救主；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "为我降生、受 死、复活、再临,永 远同住。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s1_v2",
        "text": "耶稣，这名甜美、芬芳，慰我愁苦心灵；",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "我心欢乐,我口歌唱这个宝贵的名。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s1_v3",
        "text": "耶稣乃是生命、亮光，乃是真理、道路；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "今在我心作主作王，将我引导安抚。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s1_v4",
        "text": "宝贵救主远胜奇珍，时刻满足我心；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "解我愁苦，消我烦闷，永远与我相亲。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s1_v5",
        "text": "荣哉！乐哉！耶稣我主，永是我的荣耀；",
        "label": "第5段：第1谱行"
      },
      {
        "region": "s2_v5",
        "text": "荣耀之名乃是耶稣，我要永远称道。（阿们）",
        "label": "第5段：第2谱行"
      }
    ],
