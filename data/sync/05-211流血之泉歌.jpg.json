    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "今有-一处流血之泉，从主身上发源，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "罪人只要在此一洗，能去全身罪。",
        "label": "第1段：第2谱行"
