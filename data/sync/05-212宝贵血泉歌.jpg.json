    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "当我见那宝贵血泉，要洗我一切罪孽，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "心中隐闻圣灵微声，问说：你愿否清洁？",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "赞美耶稣！赞美耶稣！赞美主为罪人死。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "万民当将荣耀归主，因主血能洗净众罪污。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "颂扬永归耶稣圣名，主喜欢收纳罪人，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "白白赦我一切罪恶，洗净我的污秽心。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "赞美耶稣！赞美耶稣！赞美主为罪人死。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "万民当将荣耀归主，因主血能洗净众罪污。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "荣耀、荣耀归于圣父，荣耀、荣耀归圣子，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "荣耀、荣耀归于圣灵， 荣耀归于三一主。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
