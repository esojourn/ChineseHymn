  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "与耶稣同死，因死反得生，与耶稣同活，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "因活更蒙恩；仰望我恩主荣光必照临，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "每时而每刻我蒙主鸿恩。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "每时而每刻蒙主之保佑，每时而每刻因主我得救；",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "仰望主耶稣荣光必照临，每时而每刻我为主子民。",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s1_v2",
        "text": "无有一试探我主不体谅，无有一重担",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "我主不担当，无有一忧虑我主不与分，",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "每时而每刻我蒙主鸿恩。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "每时而每刻蒙主之保佑，每时而每刻因主我得救；",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "仰望主耶稣荣光必照临，每时而每刻我为主子民。",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s1_v3",
        "text": "无有一悲伤我主不安慰，无有一眼泪",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "我主不宝贵，无有一危险我主不同在，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "每时而每刻我得主恩爱。",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "每时而每刻蒙主之保佑，每时而每刻因主我得救；",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "仰望主耶稣荣光必照临，每时而每刻我为主子民。",
        "label": "第3段：第5谱行"
      },
      {
        "region": "s1_v4",
        "text": "无有一懦弱我主不扶助，无有一病患",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "我主不看顾；无论我前途遇苦或遇福，",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "耶稣我救主必时常保护。",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "每时而每刻蒙主之保佑，每时而每刻因主我得救；",
        "label": "第4段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "仰望主耶稣荣光必照临，每时而每刻我为主子民。",
        "label": "第4段：第5谱行"
