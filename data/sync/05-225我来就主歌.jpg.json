    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "就是这样，无善可陈，但因我主流血深恩，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "又因我主召我亲近，上主羔羊，我来，",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s1_v2",
        "text": "就是这样，不必等待自己洗除一点微罪，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "因主宝血能消万秽，上主羔羊，我来，",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s1_v3",
        "text": "就是这样，心灵不安，多少冲突，多少疑难，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "我心内外不断争战，上主羔羊，我来，",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s1_v4",
        "text": "就是这样，主肯收留，欢迎、洗罪、饶恕、拯救，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "因主应许必能成就，上主羔羊，我来，",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s1_v5",
        "text": "就是这样，深恩妙爱，打破一切艰难阻碍，",
        "label": "第5段：第1谱行"
      },
      {
        "region": "s2_v5",
        "text": "我来。（阿们）",
        "label": "第5段：第2谱行"
      }
    ],
