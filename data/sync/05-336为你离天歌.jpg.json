  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "我为你离天庭，尊贵、荣耀、光明；",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "放下丰富权柄，降临尘世卑贫。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "我舍所有为你，为你，你舍什么为我？",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "我舍所有为你，为你，你舍什么为我？",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "为你我不顾己，来到世界阴，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "且无栖身之地，被放在马槽里。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "不顾自己为你，为你，你怎样对待我？",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "不顾自己为你，为你，你怎样对待我？",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "我路崎岖难行，常遇逼迫艰辛；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "受人顶撞刺心，孤单无人同情。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "我受羞辱为你，为你，你当怎样为我？",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "我受羞辱为你，为你，你当怎样为我？",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "我为你受拘禁，被人戏弄欺凌；",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "在十架上被钉，遍身鲜血漓淋。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_v4",
        "text": "倾倒生命为你，为你，你献什么给我？",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_v4",
        "text": "倾倒生命为你，为你，你献什么给我？",
        "label": "第4段：第4谱行"
      },
      {
        "region": "s1_v5",
        "text": "我既这样爱你，舍去一切为你。",
        "label": "第5段：第1谱行"
      },
      {
        "region": "s2_v5",
        "text": "现今在父右边，时常祈求为你。",
        "label": "第5段：第2谱行"
      },
      {
        "region": "s3_v5",
        "text": "愿否献上你心归我，全心尊我为主？",
        "label": "第5段：第3谱行"
      },
      {
        "region": "s4_v5",
        "text": "愿否献上你心归我，全心尊我为主？",
        "label": "第5段：第4谱行"
      }
    ],
