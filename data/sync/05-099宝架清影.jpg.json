  "provenance": {
    "batch": "bulk-2026-10",
    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "在主宝架清影中,欢然立定脚跟，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "好似盛暑远行辛苦,来进磐石之荫；",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": "好似旷野欣逢居处,长途喜见凉亭，",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_v1",
        "text": "到此得息肩头重担,养力奔赴前程。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "神圣庄严之十架,我常抬头瞻仰，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "双眼如见宝血倾流，为我舍身之像；",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "热泪满眶，寸心如裂，两事仔细思量：",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_v2",
        "text": "思量我身不配受恩，思量主爱非常。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "愿在宝架清影中，事主，爱人，行道；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "我不寻求旭日光华，因有慈光普照；",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_v3",
        "text": "世界荣华,不足贪图，得失无关重要，",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_v3",
        "text": "但将罪恶看为羞耻,宝架看为荣耀。",
        "label": "第3段：第4谱行"
      }
    ],
