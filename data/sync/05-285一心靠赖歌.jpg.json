    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": "凡我疑惑，全交耶稣，因我曾闻主应许，",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "说“你永不抱愧蒙羞”我今信靠此言语。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "我今 靠赖，一心 靠赖，我惟靠赖主应 许。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我今 靠赖，一心 靠赖，我惟靠赖主应许。",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s1_v2",
        "text": "凡我罪恶，全交耶稣，主血洗净全无瑕，",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "我因靠他，得成圣洁，主必接我到父家。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "我今 靠赖，一心 靠赖，我惟靠赖主应 许。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我今 靠赖，一心 靠赖，我惟靠赖主应许。",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s1_v3",
        "text": "凡我畏惧，全交耶稣，我灵疲乏得依靠；",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "我虽经过黑暗路途，有主同在蒙光照。",
        "label": "第3段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "我今 靠赖，一心 靠赖，我惟靠赖主应 许。",
        "label": "第3段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我今 靠赖，一心 靠赖，我惟靠赖主应许。",
        "label": "第3段：第4谱行"
      },
      {
        "region": "s1_v4",
        "text": "凡我快乐，全交耶稣，只因万福在主内，",
        "label": "第4段：第1谱行"
      },
      {
        "region": "s2_v4",
        "text": "世界万有皆属救主，凡我所需主预备。",
        "label": "第4段：第2谱行"
      },
      {
        "region": "s3_chorus",
        "text": "我今 靠赖，一心 靠赖，我惟靠赖主应 许。",
        "label": "第4段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "我今 靠赖，一心 靠赖，我惟靠赖主应许。",
        "label": "第4段：第4谱行"
      },
      {
        "region": "s1_v5",
        "text": "我将自已全交耶稣，身体灵魂求保全，",
        "label": "第5段：第1谱行"
      },
      {
        "region": "s2_v5",
        "text": "凡我所有，凡我所望，全交我主到永远。",
