    "method": "Numbered-score melody/chroma matching with two rhythm templates and measured repeats.",
    "performanceOrder": [
      {
        "region": "s1_v1",
        "text": ".大時哉！圣哉！層耶層稣之名！層",
        "label": "第1段：第1谱行"
      },
      {
        "region": "s2_v1",
        "text": "天上万军颂扬，天上万军颂扬。",
        "label": "第1段：第2谱行"
      },
      {
        "region": "s3_v1",
        "text": ".奉献冠冕，极其光荣。",
        "label": "第1段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "庆贺他！贺他！贺他！",
        "label": "第1段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "贺他！庆贺他为君王！（阿们）",
        "label": "第1段：第5谱行"
      },
      {
        "region": "s1_v2",
        "text": "天鍵上時地層下個闻時主鍵尊層名，鍵",
        "label": "第2段：第1谱行"
      },
      {
        "region": "s2_v2",
        "text": "应该敬畏颂扬，应该敬畏颂扬。",
        "label": "第2段：第2谱行"
      },
      {
        "region": "s3_v2",
        "text": "万膝跪拜，万口归荣。",
        "label": "第2段：第3谱行"
      },
      {
        "region": "s4_chorus",
        "text": "庆贺他！贺他！贺他！",
        "label": "第2段：第4谱行"
      },
      {
        "region": "s5_chorus",
        "text": "贺他！庆贺他为君王！（阿们）",
        "label": "第2段：第5谱行"
      },
      {
        "region": "s1_v3",
        "text": "尊贵、荣耀、智慧、能力，",
        "label": "第3段：第1谱行"
      },
      {
        "region": "s2_v3",
        "text": "都归被杀羔羊，都归被杀羔羊。",
        "label": "第3段：第2谱行"
